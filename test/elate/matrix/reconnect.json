{
  "name": "reconnect",
  "comment": "Connections that drop while a session is attached: a lost stream resumes without losing or repeating output, a lost control connection is redialled and typing meanwhile arrives afterwards, a write whose answer was lost is not repeated, uploads during a redial, a relay that dies and comes back, a connection that stays open but silent, an upload whose link stalls, an upload cut off halfway, a block whose data.connect was lost, a refused HELLO, keys typed before a new client is attached, an upload started and a detach run while a redialled session is being attached.",
  "params": {"host": "unix"},
  "variants": {
    "unix": {"host": "unix"},
    "tcp": {"host": "tcp"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(rexel-elate-start \"{{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"type": "echo r0-$((6*7))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r0-42$\")"},

    {"group": "stream-drop", "comment": "a dropped data connection resumes: output from the gap arrives once"},
    {"eval": "(setq rexel-elate-stream rexel--stream)"},
    {"type": "sleep 2; echo d1-$((40+2))"},
    {"keys": "RET"},
    {"wait": "idle", "min_idle": 0.5},
    {"eval": "(rexel-elate-drop-connection 'data)"},
    {"wait": "until", "pred": "(rexel-elate-has \"^d1-42$\")"},
    {"assert": {"eval": "(and (rexel-elate-live-p) (= 1 (rexel-elate-count \"^d1-42$\")))"}},
    {"assert": {"eval": "(eq rexel--stream rexel-elate-stream)"}, "comment": "resumed, not streamed afresh"},
    {"assert": {"eval": "(rexel-elate-has \"^r0-42$\")"}},

    {"group": "control-drop", "comment": "a dropped control connection is redialled; keys typed meanwhile are sent once it is back"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-drop-connection 'control)"},
    {"type": "echo c1-$((5*5))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: connection to {{host}} lost, reconnecting\")"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: reconnected to {{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^c1-25$\")"},
    {"assert": {"eval": "(and (rexel-elate-live-p) (= 1 (rexel-elate-count \"^c1-25$\")))"}},
    {"assert": {"eval": "(eq rexel--stream rexel-elate-stream)"}, "comment": "the stream stayed up meanwhile"},

    {"group": "write-in-flight", "comment": "a write whose answer the dropped connection lost is not sent again: the server may have run it, and it must not run twice"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(progn (rexel-elate-send \"echo w1-$((7*7))\\r\") (rexel-elate-drop-connection 'control))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(rexel-elate-send \"echo w2-$((7*8))\\r\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^w2-56$\")"},
    {"assert": {"eval": "(<= (rexel-elate-count \"^w1-49$\") 1)"}, "comment": "whether the server ran it depends on when it saw the connection end"},

    {"group": "upload-redial", "comment": "while the control connection is redialled, a dropped file fails at once with a message and rexel-upload-file refuses; the block stays usable"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(progn (rexel-elate-drop-connection 'control) (rexel-elate-dnd (list (rexel-elate-file \"redial-a.txt\" 5000))))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: Not connected\")"},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"assert": {"eval": "(progn (rexel-elate-drop-connection 'control) (condition-case nil (progn (rexel-upload-file (list (rexel-elate-file \"redial-b.txt\" 5000))) nil) (user-error t)))"}},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(rexel-elate-send \"echo rd-$((6*9))\\r\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^rd-54$\")"},

    {"group": "relay-restart", "comment": "the whole path dies and returns: rexel reconnects with backoff and shows the block again, at the size it had"},
    {"eval": "(setq rexel-elate-size-before (rexel-elate-size))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-relay-stop '{{host}})"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: connection to {{host}} lost, reconnecting\")"},
    {"assert": {"eval": "(not (rexel-elate-live-p))"}},
    {"type": "echo l1-$((3*3))"},
    {"keys": "RET"},
    {"wait": "idle", "min_idle": 3, "timeout": 10},
    {"eval": "(rexel-elate-relay-start '{{host}})"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")", "timeout": 45},
    {"wait": "until", "pred": "(rexel-elate-live-p)", "timeout": 20},
    {"wait": "until", "pred": "(rexel-elate-has \"^l1-9$\")", "timeout": 20},
    {"assert": {"eval": "(and (rexel-elate-has \"^r0-42$\") (rexel-elate-has \"^c1-25$\"))"}, "comment": "the earlier output is back"},
    {"type": "echo l2-$((4*4))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^l2-16$\")"},
    {"wait": "until", "pred": "(equal (rexel-elate-size) rexel-elate-size-before)"},

    {"group": "half-open", "comment": "a connection that stays open but carries nothing is pinged, dropped and redialled; the write sent into it is reported and not repeated, and text typed after it arrives once"},
    {"eval": "(progn (setq rexel--keepalive-interval 2 rexel--connect-timeout 2) (rexel--keepalive))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(progn (setq rexel-elate-prompts (rexel-elate-count \"^\\\\$\")) (rexel-elate-relay-freeze '{{host}}))"},
    {"eval": "(rexel-elate-send \"echo k1-$((8*8))\")", "comment": "one write, sent into the dead connection"},
    {"keys": "RET", "comment": "typed while that write is unanswered: held back, and the probe it starts finds the connection dead"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: connection to {{host}} lost, reconnecting\")", "timeout": 30},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")", "timeout": 45},
    {"assert": {"eval": "(rexel-elate-messages-p \"keys typed as the connection dropped may be lost\")"}},
    {"wait": "until", "pred": "(rexel-elate-live-p)", "timeout": 30},
    {"wait": "until", "pred": "(> (rexel-elate-count \"^\\\\$\") rexel-elate-prompts)", "comment": "the held-back RET arrived"},
    {"eval": "(rexel-elate-relay-reap)"},
    {"eval": "(setq rexel--keepalive-interval 30 rexel--connect-timeout 10)"},
    {"eval": "(rexel-elate-send \"echo k2-$((9*9))\\r\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^k2-81$\")"},
    {"assert": {"eval": "(and (zerop (rexel-elate-count \"^k1-64$\")) (= 1 (rexel-elate-count \"^k2-81$\")))"}, "comment": "the write that went into the dead connection is not sent again"},

    {"group": "upload-stall", "comment": "an upload whose link stalls without closing fails once the connection took no chunk within rexel--connect-timeout; Emacs then takes keys again, nothing is typed, and the block recovers once the link is gone"},
    {"eval": "(setq rexel--connect-timeout 3)"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-send \"echo s-stall-$((2*4)) \")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ echo s-stall-\")"},
    {"eval": "(progn (rexel-elate-hold-upload 1000000) (rexel-upload-file (list (rexel-elate-sparse-file \"stall.bin\" (* 90 1024 1024)))))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)"},
    {"eval": "(rexel-elate-relay-freeze '{{host}})"},
    {"eval": "(progn (rexel-elate-key-probe-arm) (rexel-elate-release-upload))"},
    {"wait": "until", "pred": "(rexel-elate-upload-stalled-p 1)", "comment": "the link takes no more bytes"},
    {"keys": "M-x rexel-elate-key-probe RET", "delivery": "raw"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: stall\\\\.bin: the connection stalled\")", "timeout": 15},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},
    {"wait": "until", "pred": "(rexel-elate-key-latency)", "timeout": 5, "comment": "the keys typed during the stall run"},
    {"assert": {"eval": "(< (rexel-elate-key-latency) 8)"}},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-relay-reap)", "comment": "the link dies for good"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")", "timeout": 45},
    {"wait": "until", "pred": "(rexel-elate-live-p)", "timeout": 30},
    {"eval": "(setq rexel--connect-timeout 10)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"s-stall-8$\")", "timeout": 20, "comment": "no path after it; not anchored at the line start, as a resize from a long message makes bash redraw the line"},

    {"group": "upload-cut", "comment": "an upload whose connection dies halfway through a file fails, types nothing and leaves the block usable; the server discards what it had stored"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(setq rexel-elate-stored (length (rexel-elate-uploads)))"},
    {"eval": "(rexel-elate-send \"echo x-cut-$((6*6)) \")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ echo x-cut-\")"},
    {"eval": "(progn (rexel-elate-hold-upload 1000000) (rexel-upload-file (list (rexel-elate-file \"cut-a.txt\" 500) (rexel-elate-sparse-file \"cut-b.bin\" (* 90 1024 1024)))))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)", "timeout": 20},
    {"assert": {"eval": "(< rexel-elate-stored (length (rexel-elate-uploads)))"}, "comment": "the server holds the files meanwhile"},
    {"eval": "(rexel-elate-relay-stop '{{host}})"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: \")"},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},
    {"eval": "(rexel-elate-release-upload)", "comment": "sends nothing for a batch that failed"},
    {"eval": "(rexel-elate-relay-start '{{host}})"},
    {"wait": "until", "pred": "(rexel-elate-live-p)", "timeout": 45},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"x-cut-36$\")", "timeout": 20, "comment": "no path after it; not anchored at the line start, as a resize from a long message makes bash redraw the line"},
    {"wait": "until", "pred": "(= rexel-elate-stored (length (rexel-elate-uploads)))", "timeout": 30},

    {"group": "lost-connect", "comment": "the data.connect of a new block goes with the control connection: after the reconnect the block is streamed and takes keys, and so does the block that was running"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(setq rexel-elate-first (current-buffer))"},
    {"eval": "(progn (rexel-elate-drop-after-connect) (rexel-split-below))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")", "timeout": 45},
    {"wait": "until", "pred": "(and (not (eq (window-buffer) rexel-elate-first)) (rexel-elate-live-p))", "timeout": 20},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"eval": "(rexel-elate-send \"echo m1-$((6*6))\\r\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^m1-36$\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p rexel-elate-first)", "timeout": 20, "comment": "the server may have started a new client, which ends the streams it had"},
    {"eval": "(rexel-elate-send \"echo m2-$((7*7))\\r\" rexel-elate-first)"},
    {"wait": "until", "pred": "(rexel-elate-has \"^m2-49$\" rexel-elate-first)"},

    {"group": "refused-hello", "comment": "the server refuses the first HELLO of a block streamed afresh, with no view event to follow: rexel gets a new ticket once, and the block goes live and takes keys"},
    {"eval": "(progn (rexel-elate-spoil-hello) (rexel--restart-stream (current-buffer) \"test\"))"},
    {"wait": "until", "pred": "(rexel-elate-live-p)", "timeout": 20},
    {"assert": {"eval": "(not (advice-member-p 'rexel-elate-spoil 'rexel--hello))"}, "comment": "the spoiled HELLO was sent"},
    {"eval": "(rexel-elate-send \"echo h1-$((5*7))\\r\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^h1-35$\")"},

    {"group": "attach-hold", "comment": "after a reconnect the server does not resume, keys typed before the session.attach answer wait for it: the server refuses typing from a connection not attached"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(progn (rexel-elate-delay-request \"session.attach\" 1.5) (setf (rexel--conn-token rexel--conn) nil) (rexel-elate-drop-connection 'control))", "comment": "without its token the hello starts a new client"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: re-attached as a new client to {{host}}\")"},
    {"eval": "(rexel-elate-send \"echo g1-$((4*12))\\r\")", "comment": "typed while the attach is on its way"},
    {"eval": "(rexel-elate-undelay-requests)"},
    {"wait": "until", "pred": "(rexel-elate-live-p)", "timeout": 20},
    {"wait": "until", "pred": "(rexel-elate-has \"^g1-48$\")", "timeout": 20},
    {"assert": {"eval": "(not (rexel-elate-messages-p \"terminal.write\"))"}, "comment": "no write was refused"},

    {"group": "upload-while-attaching", "comment": "an upload started while the session.attach answer after a redial is pending waits for it instead of failing with conflict, and succeeds"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(setq rexel-elate-first (current-buffer) rexel-elate-sid rexel--session-id rexel-elate-conn rexel--conn)"},
    {"eval": "(rexel-elate-send \"echo u0-$((3*13))\\r\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^u0-39$\")"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(progn (rexel-elate-delay-request \"session.attach\" 3) (setf (rexel--conn-token rexel--conn) nil) (rexel-elate-drop-connection 'control))", "comment": "without its token the hello starts a new client"},
    {"wait": "until", "pred": "(member rexel-elate-sid (rexel--conn-attaching rexel-elate-conn))", "timeout": 20, "comment": "the attach is pending"},
    {"eval": "(setq rexel-elate-up (rexel-elate-file \"attaching.txt\" 20000))"},
    {"eval": "(progn (with-current-buffer rexel-elate-first (rexel-upload-file (list rexel-elate-up))) (rexel-elate-undelay-requests))"},
    {"assert": {"eval": "(member rexel-elate-sid (rexel--conn-attaching rexel-elate-conn))"}, "comment": "the upload started inside the window"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")", "timeout": 30},
    {"assert": {"eval": "(and (not (rexel-elate-uploading-p)) (not (rexel-elate-messages-p \"conflict\")) (not (rexel-elate-messages-p \"upload failed\")))"}},
    {"wait": "until", "pred": "(rexel-elate-has \"cksum .*attaching\\\\.txt\")", "comment": "the path is typed, not yet run"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-cksum-line rexel-elate-up))", "timeout": 20},
    {"assert": {"eval": "(not (member rexel-elate-sid (rexel--conn-attaching rexel-elate-conn)))"}},

    {"group": "detach-while-attaching", "comment": "rexel-detach while the session.attach answer after a redial is pending drops the session for good: the late answer brings no buffer back, and rexel sends session.detach again, so the server no longer lists this client"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(progn (setq rexel-elate-log nil rexel-elate-clients-before (rexel-elate-client-count rexel-elate-sid)) (advice-add 'rexel--request :before (lambda (_conn name &rest _) (push name rexel-elate-log)) '((name . rexel-elate-log))))"},
    {"assert": {"eval": "(>= rexel-elate-clients-before 1)"}, "comment": "the server lists this client while attached"},
    {"eval": "(progn (rexel-elate-delay-request \"session.attach\" 3) (setf (rexel--conn-token rexel--conn) nil) (rexel-elate-drop-connection 'control))"},
    {"wait": "until", "pred": "(member rexel-elate-sid (rexel--conn-attaching rexel-elate-conn))", "timeout": 20, "comment": "the attach is pending"},
    {"eval": "(setq rexel-elate-log nil)"},
    {"eval": "(progn (with-current-buffer rexel-elate-first (rexel-detach)) (rexel-elate-undelay-requests))"},
    {"assert": {"eval": "(and (not (buffer-live-p rexel-elate-first)) (null (rexel--session-buffers rexel-elate-sid)) (null (assoc rexel-elate-sid (rexel--conn-sessions rexel-elate-conn))) (null (rexel--conn-attaching rexel-elate-conn)))"}},
    {"wait": "until", "pred": "(member \"session.attach\" rexel-elate-log)", "timeout": 15, "comment": "the delayed attach is sent"},
    {"wait": "until", "pred": "(>= (cl-count \"session.detach\" rexel-elate-log :test #'equal) 2)", "timeout": 15, "comment": "rexel detaches again once the late answer arrives"},
    {"wait": "idle", "min_idle": 2, "timeout": 10},
    {"assert": {"eval": "(and (null (rexel--session-buffers rexel-elate-sid)) (null (cl-remove-if-not (lambda (b) (buffer-local-value 'rexel--session-id b)) (buffer-list))) (null (assoc rexel-elate-sid (rexel--conn-sessions rexel-elate-conn))) (null (rexel--conn-attaching rexel-elate-conn)))"}, "comment": "nothing came back"},
    {"eval": "(rexel--refresh-view rexel-elate-conn rexel-elate-sid)"},
    {"wait": "idle", "min_idle": 1.5, "timeout": 10},
    {"assert": {"eval": "(null (cl-remove-if-not (lambda (b) (buffer-local-value 'rexel--session-id b)) (buffer-list)))"}, "comment": "not after a view refresh either"},
    {"assert": {"eval": "(zerop (rexel-elate-client-count rexel-elate-sid))"}, "comment": "the server lists no client attached"},
    {"assert": {"eval": "(rexel-elate-on-server-p)"}, "comment": "the session still exists, to be destroyed in cleanup"},
    {"eval": "(advice-remove 'rexel--request 'rexel-elate-log)"},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
