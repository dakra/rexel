{
  "name": "consult",
  "comment": "The pickers of consult-rexel, driven through their prompts with the default completion: consult-rexel-project for the session of a project and consult-rexel for every session.  They use this machine's server and need consult, see rexel-elate-load-consult.",
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(advice-add 'ghostel--osc133-marker :override #'ignore '((name . rexel-elate-no-osc133)))", "comment": "OSC 133 marks from the user's shell startup files go unseen"},
    {"eval": "(rexel-elate-use \"local\")"},
    {"eval": "(progn (rexel-elate-load-consult) (setq rexel-default-session (concat rexel-elate-label \"-home\") rexel-elate-proj (concat rexel-elate-label \"-proj\") rexel-elate-home (concat rexel-elate-label \"-home\") rexel-elate-root (rexel-elate-project \"-proj\")) (find-file (expand-file-name \"src/a.txt\" rexel-elate-root)) (delete-other-windows))"},

    {"group": "project-new-name", "comment": "in consult-rexel-project a name that matches nothing creates the project's session with a tab of that label"},
    {"keys": "M-x consult-rexel-project RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Project Rex block: "}}},
    {"assert": {"eval": "(rexel-elate-choice-p \"New\" \"New Rex tab\")"}},
    {"assert": {"eval": "(or (not (featurep 'consult-ghostel)) (rexel-elate-choice-p \"New\" \"Create a new project Ghostel terminal\"))"}, "comment": "the candidates of consult-ghostel-project follow"},
    {"eval": "(rexel-elate-answer \"logs\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-named-p \"logs\" nil \"-proj\"))"},
    {"assert": {"eval": "(= 1 (rexel-elate-session-count \"-proj\"))"}},
    {"eval": "(setq rexel-elate-logs (rexel-elate-block))"},

    {"group": "project-pick", "comment": "the project's blocks are listed under its session and picked by name"},
    {"eval": "(switch-to-buffer \"a.txt\")"},
    {"keys": "M-x consult-rexel-project RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (cons rexel-elate-proj (buffer-name rexel-elate-logs)) (car (rexel-elate-grouped-choices)))"}, "comment": "the session's group comes first"},
    {"eval": "(rexel-elate-answer (buffer-name rexel-elate-logs))"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (eq (window-buffer) rexel-elate-logs) (not (active-minibuffer-window)))"},

    {"group": "project-new-tab", "comment": "the New Rex tab candidate opens a tab at the project's root"},
    {"eval": "(switch-to-buffer \"a.txt\")"},
    {"keys": "M-x consult-rexel-project RET", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer \"New Rex tab\")"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (= 2 (length (rexel-elate-blocks rexel-elate-proj))) (rexel-elate-live-p) (rexel-elate-named-p \"2\" nil \"-proj\"))"},
    {"type": "echo p1:$PWD:"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (concat \"^p1:.*/\" (regexp-quote rexel-elate-proj) \":$\"))"},

    {"group": "project-attach", "comment": "a session this Emacs is not attached to is attached before its blocks are listed"},
    {"eval": "(with-current-buffer (rexel-elate-block) (rexel-detach))"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks))"},
    {"eval": "(switch-to-buffer \"a.txt\")"},
    {"keys": "M-x consult-rexel-project RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(and (rexel-elate-choice-p rexel-elate-proj (format \"*rex:%s:logs*\" rexel-elate-proj)) (rexel-elate-choice-p rexel-elate-proj (format \"*rex:%s:2*\" rexel-elate-proj)))"}},
    {"keys": "C-g", "delivery": "events"},
    {"wait": "until", "pred": "(not (active-minibuffer-window))"},
    {"assert": {"eval": "(and (= 2 (length (rexel-elate-blocks))) (= 1 (rexel-elate-session-count \"-proj\")))"}},

    {"group": "groups", "comment": "consult-rexel groups the blocks by session, the current project's first, and lists the other sessions"},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "M-x rexel RET"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-named-p \"1\" nil \"-home\"))"},
    {"eval": "(switch-to-buffer \"a.txt\")"},
    {"keys": "M-x consult-rexel RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Rex block or session: "}}},
    {"assert": {"eval": "(equal rexel-elate-proj (caar (rexel-elate-grouped-choices)))"}},
    {"assert": {"eval": "(and (rexel-elate-choice-p rexel-elate-home (format \"*rex:%s:1*\" rexel-elate-home)) (rexel-elate-choice-p \"New\" \"New Rex tab\") (rexel-elate-choice-p \"New\" \"New Rex session\"))"}},
    {"assert": {"eval": "(not (seq-some (lambda (c) (and (equal (car c) \"Session\") (member (cdr c) (list rexel-elate-proj rexel-elate-home)))) (rexel-elate-grouped-choices)))"}, "comment": "a session with blocks here is a group, not a candidate"},
    {"eval": "(rexel-elate-answer \"notes\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-named-p \"notes\" nil \"-home\"))"},

    {"group": "session", "comment": "a session that is not attached is a candidate, and choosing it attaches it"},
    {"eval": "(with-current-buffer (car (rexel-elate-blocks rexel-elate-proj)) (rexel-detach))"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks rexel-elate-proj))"},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "M-x consult-rexel RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(rexel-elate-choice-p \"Session\" rexel-elate-proj)"}},
    {"eval": "(setq rexel-attach-display 'focused)"},
    {"eval": "(rexel-elate-answer rexel-elate-proj)"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (= 2 (length (rexel-elate-blocks rexel-elate-proj))) (not (active-minibuffer-window)))"},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
