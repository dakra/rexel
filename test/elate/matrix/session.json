{
  "name": "session",
  "comment": "The life of a session, driven through the commands and their prompts: create, type, rename, detach, attach, kill a buffer, choose a host, lose the session to another client, and a server that is not there.",
  "params": {"host": "local", "hostname": "this machine", "other": "unix", "dirfollows": "t"},
  "variants": {
    "local": {"host": "local", "hostname": "this machine", "other": "unix", "dirfollows": "t"},
    "unix": {"host": "unix", "hostname": "unix", "other": "local", "dirfollows": "nil"},
    "tcp": {"host": "tcp", "hostname": "tcp", "other": "local", "dirfollows": "nil"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "new-session", "comment": "C-u M-x rexel-new-session asks for a label, creates the session and shows its shell"},
    {"eval": "(advice-add 'ghostel--osc133-marker :override #'ignore '((name . rexel-elate-no-osc133)))", "comment": "OSC 133 marks from the user's shell startup files go unseen: the block's shell counts as one without integration"},
    {"eval": "(rexel-elate-use \"{{host}}\")"},
    {"keys": "C-u M-x rexel-new-session RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Session label: "}}},
    {"eval": "(rexel-elate-answer-label)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"assert": {"eval": "(and rexel--block-id rexel-block-mode (derived-mode-p 'ghostel-mode))"}, "comment": "the selected window shows the block"},
    {"assert": {"eval": "(rexel-elate-buffer-name-p)"}},
    {"assert": {"eval": "(rexel-elate-on-server-p)"}},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},

    {"group": "type", "comment": "a typed command runs in the session's shell"},
    {"type": "echo s1-$((6*7))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^s1-42$\")"},

    {"group": "directory", "comment": "default-directory follows the shell on this machine's server and stays put on a labelled host, whose paths are another machine's"},
    {"eval": "(setq rexel-elate-dir0 default-directory)"},
    {"type": "cd /usr/share"},
    {"keys": "RET"},
    {"type": "sleep 2"},
    {"keys": "RET"},
    {"wait": "until", "pred": "ghostel--command-running", "timeout": 10},
    {"wait": "until", "pred": "(not ghostel--command-running)", "comment": "a process report from the shell in /usr/share arrived"},
    {"assert": {"eval": "(eq (equal default-directory \"/usr/share/\") {{dirfollows}})"}},
    {"assert": {"eval": "(or {{dirfollows}} (equal default-directory rexel-elate-dir0))"}},

    {"group": "rename", "comment": "C-c C-r $ offers the current label and renames the session and its buffers"},
    {"keys": "C-c C-r $", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (with-selected-window (active-minibuffer-window) (minibuffer-contents)) rexel-elate-label)"}},
    {"eval": "(rexel-elate-answer-label \"-renamed\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-buffer-name-p \"-renamed\")"},
    {"assert": {"eval": "(and (rexel-elate-on-server-p \"-renamed\") (not (rexel-elate-on-server-p)))"}},
    {"keys": "C-c C-r $", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer-label)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-buffer-name-p)"},

    {"group": "label-function", "comment": "rexel-session-label-function names a session created without a label"},
    {"eval": "(setq rexel-session-label-function (lambda (label) (if (string-empty-p label) (concat rexel-elate-label \"-fn\") label)))"},
    {"keys": "M-x rexel-new-session RET"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-buffer-name-p \"-fn\"))"},
    {"eval": "(setq rexel-session-label-function nil)"},
    {"assert": {"eval": "(rexel-elate-on-server-p \"-fn\")"}},

    {"group": "server-label", "comment": "M-x rexel-new-session without a label lets the server choose one, which names the buffer"},
    {"keys": "M-x rexel-new-session RET"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p (window-buffer)) (not (string-prefix-p (concat \"*rex:\" rexel-elate-label) (buffer-name (window-buffer)))))"},
    {"eval": "(setq rexel-elate-auto-sid rexel--session-id rexel-elate-auto-name (buffer-name) rexel-elate-auto-label (rexel-elate--control (lambda (c) (car (rassoc rexel--session-id (rexel-elate-sessions c))))))"},
    {"eval": "(rexel-rename-session (concat rexel-elate-label \"-auto\"))", "comment": "under the scenario's label, cleanup destroys it"},
    {"wait": "until", "pred": "(rexel-elate-buffer-name-p \"-auto\")"},
    {"assert": {"eval": "(and (stringp rexel-elate-auto-label) (string-match-p \"\\\\`[a-z]+\\\\(-[a-z]+\\\\)+\\\\'\" rexel-elate-auto-label))"}, "comment": "a label such as quiet-meadow"},
    {"assert": {"eval": "(string-prefix-p (concat \"*rex:\" rexel-elate-auto-label (if (rexel--conn-host rexel--conn) \"@\" \":\")) rexel-elate-auto-name)"}},
    {"keys": "C-c C-r d"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks (concat rexel-elate-label \"-auto\")))"},
    {"eval": "(pop-to-buffer-same-window (car (rexel-elate-blocks (concat rexel-elate-label \"-fn\"))))"},

    {"group": "detach", "comment": "C-c C-r d kills the session's buffers and leaves the session running"},
    {"keys": "C-c C-r d"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks (concat rexel-elate-label \"-fn\")))"},
    {"assert": {"eval": "(rexel-elate-on-server-p \"-fn\")"}},
    {"eval": "(pop-to-buffer-same-window (car (rexel-elate-blocks rexel-elate-label)))"},
    {"keys": "C-c C-r d"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks))"},
    {"assert": {"eval": "(rexel-elate-on-server-p)"}},

    {"group": "attach", "comment": "M-x rexel-attach lists the sessions; the chosen one comes back with its earlier output"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Rex session: "}}},
    {"eval": "(rexel-elate-answer-label)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"assert": {"eval": "(and rexel--block-id (rexel-elate-buffer-name-p))"}},
    {"wait": "until", "pred": "(rexel-elate-has \"^s1-42$\")"},
    {"eval": "(delete-other-windows)"},
    {"type": "echo s2-$((7*7))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^s2-49$\")"},

    {"group": "kill-buffer", "comment": "killing a block buffer leaves the block running; attaching again shows what it printed meanwhile"},
    {"eval": "(progn (make-directory rexel-elate-files-dir t) (setq s3-done (expand-file-name \"s3-done\" rexel-elate-files-dir)))"},
    {"eval": "(rexel-elate-send (format \"(sleep 3; echo s3-$((8*8)); touch %s) &\\n\" (shell-quote-argument s3-done)))"},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\[1\\\\] [0-9]+$\")", "comment": "the job started"},
    {"eval": "(kill-buffer (rexel-elate-block))"},
    {"assert": {"eval": "(and (null (rexel-elate-blocks)) (not (file-exists-p s3-done)))"}, "comment": "the buffer is gone before the job prints"},
    {"wait": "until", "pred": "(file-exists-p s3-done)", "timeout": 10, "comment": "the job printed with no buffer showing the block"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer-label)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\(\\\\$ \\\\)?s3-64$\")", "comment": "the output may follow the prompt the job's start printed"},

    {"group": "host-prompt", "comment": "with two servers known, rexel-attach asks for the server first"},
    {"keys": "C-c C-r d"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks))"},
    {"eval": "(rexel-elate-use \"{{host}}\" \"{{other}}\")"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Rex host: "}}},
    {"eval": "(rexel-elate-answer \"{{hostname}}\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"Rex session: \")"},
    {"eval": "(rexel-elate-answer-label)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"assert": {"eval": "(rexel-elate-buffer-name-p)"}},
    {"eval": "(rexel-elate-use \"{{host}}\")"},

    {"group": "attach-tabs", "comment": "attaching a session of several tabs and blocks makes a buffer for every block and shows the focused one"},
    {"eval": "(rexel-elate--control (lambda (c) (rexel-elate-call \"session.create\" `((label . ,(concat rexel-elate-label \"-tabs\")) (initial_windows . ,(vector `((layout . ,(rexel--new-shell-layout))) `((layout . ((split . ((direction . \"horizontal\") (before . ,(rexel--new-shell-layout)) (after . ,(rexel--new-shell-layout)))))))))) c)))"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer-label \"-tabs\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (buffer-local-value 'rexel--block-id (window-buffer)) (rexel-elate-buffer-name-p \"-tabs\" (window-buffer)) (= 3 (length (rexel-elate-blocks (concat rexel-elate-label \"-tabs\")))))"},
    {"wait": "until", "pred": "(seq-every-p #'rexel-elate-live-p (rexel-elate-blocks (concat rexel-elate-label \"-tabs\")))"},
    {"assert": {"eval": "(equal (rexel-elate-tabs) '(1 2))"}},
    {"assert": {"eval": "(let* ((v (rexel-elate-view)) (w (seq-find (lambda (w) (equal (alist-get 'window_id w) (alist-get 'active_window_id v))) (alist-get 'windows v)))) (equal (alist-get 'focused_block_id w) rexel--block-id))"}, "comment": "the selected window shows the focused block of the active tab"},

    {"group": "attach-again", "comment": "attaching a session that is attached already shows its focused block and makes no new buffers"},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer-label \"-tabs\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (buffer-local-value 'rexel--block-id (window-buffer)) (rexel-elate-buffer-name-p \"-tabs\" (window-buffer)))"},
    {"assert": {"eval": "(and (= 3 (length (rexel-elate-blocks (concat rexel-elate-label \"-tabs\")))) (seq-every-p #'rexel-elate-live-p (rexel-elate-blocks (concat rexel-elate-label \"-tabs\"))))"}},
    {"wait": "until", "pred": "(and (null (rexel--conn-refresh-timers rexel--conn)) (zerop (hash-table-count (rexel--conn-pending rexel--conn))))", "comment": "no view refresh is under way"},
    {"keys": "C-c C-r d"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks (concat rexel-elate-label \"-tabs\")))"},
    {"assert": {"eval": "(rexel-elate-on-server-p \"-tabs\")"}},

    {"group": "detach-refresh", "comment": "detaching while the session's view is being fetched leaves no buffer behind"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer-label \"-tabs\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (rexel-elate-buffer-name-p \"-tabs\" (window-buffer)) (seq-every-p #'rexel-elate-live-p (rexel-elate-blocks (concat rexel-elate-label \"-tabs\"))))"},
    {"eval": "(rexel-elate-delay-request \"session.detach\" 0.5)", "comment": "the server answers the view before the detach reaches it"},
    {"eval": "(progn (rexel--refresh-view rexel--conn rexel--session-id) (rexel-detach))"},
    {"wait": "idle", "min_idle": 1.5},
    {"eval": "(rexel-elate-undelay-requests)"},
    {"assert": {"eval": "(null (rexel-elate-blocks (concat rexel-elate-label \"-tabs\")))"}},

    {"group": "destroyed-elsewhere", "comment": "a session another client destroys loses its buffers here"},
    {"eval": "(rexel-elate-destroy)"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks))"},
    {"assert": {"eval": "(not (rexel-elate-on-server-p))"}},

    {"group": "no-server", "comment": "a server that is not there is reported, not waited for: at once for a network address nothing listens on and for a socket path that does not exist, after the connect timeout for an address that does not answer"},
    {"eval": "(progn (rexel-elate-clear-messages) (setq rexel-elate-hosts (list (list \"gone\" (format \"http://127.0.0.1:%d\" (rexel-elate--free-port)))) rexel-elate-t0 (float-time)))"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: cannot reach gone$\\\\|Cannot connect to http://127\\\\.0\\\\.0\\\\.1:\")", "timeout": 20},
    {"assert": {"eval": "(< (- (float-time) rexel-elate-t0) 3)"}, "comment": "a refused connection is reported at once"},
    {"assert": {"eval": "(and (null (active-minibuffer-window)) (not (seq-some (lambda (c) (equal (rexel--conn-host c) \"gone\")) rexel--conns)))"}, "comment": "no prompt opens and no redial is pending"},
    {"eval": "(progn (rexel-elate-clear-messages) (setq rexel-elate-hosts (list (list \"gone\" \"/tmp/rexel-elate-no-such.sock\"))))"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"Rex server socket /tmp/rexel-elate-no-such\\\\.sock does not exist\")"},
    {"assert": {"eval": "(null (active-minibuffer-window))"}},
    {"eval": "(progn (rexel-elate-clear-messages) (setq rexel-elate-saved-timeout rexel--connect-timeout rexel--connect-timeout 3 rexel-elate-hosts (list (list \"dark\" \"http://192.0.2.1:7297\")) rexel-elate-t0 (float-time)))", "comment": "192.0.2.1 is a documentation address no host answers"},
    {"keys": "M-x rexel-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: cannot reach dark$\\\\|Cannot connect to http://192\\\\.0\\\\.2\\\\.1:\")", "timeout": 10},
    {"assert": {"eval": "(< (- (float-time) rexel-elate-t0) 6)"}, "comment": "given up after rexel--connect-timeout"},
    {"eval": "(setq rexel--connect-timeout rexel-elate-saved-timeout)"},

    {"group": "cleanup"},
    {"eval": "(when (bound-and-true-p rexel-elate-auto-sid) (ignore-errors (rexel-elate--control (lambda (c) (rexel-elate--destroy c rexel-elate-auto-sid)))))", "comment": "the server-labelled session, if it kept its label"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
