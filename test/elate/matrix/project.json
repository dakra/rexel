{
  "name": "project",
  "comment": "The commands that stand in for ghostel's: M-x rexel with its own session, and the session of a project with rexel-project, rexel-project-new and rexel-project-kill.  They use this machine's server.",
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "rexel", "comment": "M-x rexel creates its session with a shell in default-directory and shows it in the selected window"},
    {"eval": "(advice-add 'ghostel--osc133-marker :override #'ignore '((name . rexel-elate-no-osc133)))", "comment": "OSC 133 marks from the user's shell startup files go unseen"},
    {"eval": "(rexel-elate-use \"local\")"},
    {"eval": "(progn (require 'rexel-project) (setq rexel-default-session (concat rexel-elate-label \"-home\") default-directory \"/usr/lib/\") (delete-other-windows))"},
    {"keys": "M-x rexel RET"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-named-p \"1\" nil \"-home\"))"},
    {"assert": {"eval": "(and (eq (window-buffer) (rexel-elate-block)) (= 1 (length (window-list))))"}, "comment": "shown in the selected window, as M-x ghostel shows a terminal"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"type": "echo d0:$PWD"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^d0:/usr/lib$\")"},
    {"eval": "(setq rexel-elate-first (rexel-elate-block))"},

    {"group": "again", "comment": "M-x rexel with the session attached goes back to its block and creates nothing"},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "M-x rexel RET"},
    {"wait": "until", "pred": "(eq (window-buffer) rexel-elate-first)"},
    {"assert": {"eval": "(and (= 1 (length (rexel-elate-blocks))) (= 1 (rexel-elate-session-count \"-home\")))"}},

    {"group": "new-tab", "comment": "C-u M-x rexel opens a tab whose shell starts in default-directory"},
    {"eval": "(progn (switch-to-buffer \"*scratch*\") (setq default-directory \"/usr/share/\"))"},
    {"keys": "C-u M-x rexel RET"},
    {"wait": "until", "pred": "(and (= 2 (length (rexel-elate-blocks))) (rexel-elate-live-p) (rexel-elate-named-p \"2\" nil \"-home\"))"},
    {"assert": {"eval": "(and (not (eq (window-buffer) rexel-elate-first)) (= 1 (length (window-list))))"}},
    {"type": "echo d1:$PWD"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^d1:/usr/share$\")"},
    {"eval": "(setq rexel-elate-second (rexel-elate-block))"},

    {"group": "numbered", "comment": "a numeric argument shows the tab of that number, and opens a tab when there is none"},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "C-u 1 M-x rexel RET"},
    {"wait": "until", "pred": "(eq (window-buffer) rexel-elate-first)"},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "C-u 7 M-x rexel RET"},
    {"wait": "until", "pred": "(and (= 3 (length (rexel-elate-blocks))) (rexel-elate-live-p) (rexel-elate-named-p \"3\" nil \"-home\"))"},

    {"group": "recent", "comment": "M-x rexel shows the block that was selected last"},
    {"eval": "(progn (switch-to-buffer rexel-elate-second) (switch-to-buffer \"*scratch*\"))"},
    {"keys": "M-x rexel RET"},
    {"wait": "until", "pred": "(eq (window-buffer) rexel-elate-second)"},

    {"group": "attach", "comment": "M-x rexel attaches the session the server still has instead of creating one"},
    {"eval": "(with-current-buffer rexel-elate-first (rexel-detach))"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks))"},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "M-x rexel RET"},
    {"wait": "until", "pred": "(and (= 3 (length (rexel-elate-blocks))) (buffer-local-value 'rexel--block-id (window-buffer)) (rexel-elate-live-p))"},
    {"assert": {"eval": "(= 1 (rexel-elate-session-count \"-home\"))"}},

    {"group": "empty-session", "comment": "a session whose blocks were all closed stays, and M-x rexel opens a tab in it"},
    {"wait": "idle", "min_idle": 1},
    {"eval": "(mapc #'kill-buffer (rexel-elate-blocks))"},
    {"assert": {"eval": "(null (rexel-elate-blocks))"}},
    {"eval": "(switch-to-buffer \"*scratch*\")"},
    {"keys": "M-x rexel RET"},
    {"wait": "until", "pred": "(and (= 1 (length (rexel-elate-blocks))) (rexel-elate-live-p) (rexel-elate-named-p \"1\" nil \"-home\"))"},
    {"assert": {"eval": "(= 1 (rexel-elate-session-count \"-home\"))"}},

    {"group": "project", "comment": "M-x rexel-project creates a session named after the project, its shell in the project's root"},
    {"eval": "(progn (setq rexel-elate-root (rexel-elate-project \"-proj\")) (find-file (expand-file-name \"src/a.txt\" rexel-elate-root)))"},
    {"keys": "M-x rexel-project RET"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-named-p \"1\" nil \"-proj\"))"},
    {"type": "echo p0:$PWD:"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (concat \"^p0:.*/\" (regexp-quote rexel-elate-label) \"-proj:$\"))"},

    {"group": "project-new", "comment": "M-x rexel-project-new opens a second tab in the project's session"},
    {"eval": "(switch-to-buffer \"a.txt\")"},
    {"keys": "M-x rexel-project-new RET"},
    {"wait": "until", "pred": "(and (= 2 (length (rexel-elate-blocks (concat rexel-elate-label \"-proj\")))) (rexel-elate-live-p) (rexel-elate-named-p \"2\" nil \"-proj\"))"},
    {"assert": {"eval": "(= 1 (rexel-elate-session-count \"-proj\"))"}},

    {"group": "project-kill-running", "comment": "M-x rexel-project-kill kills the project's buffers; a session that runs a command asks, and declining keeps it"},
    {"eval": "(setq rexel-elate-p2 (rexel-elate-block))"},
    {"eval": "(rexel-elate-send \"sleep 300\\n\")"},
    {"wait": "until", "pred": "(buffer-local-value 'ghostel--command-running rexel-elate-p2)"},
    {"eval": "(switch-to-buffer \"a.txt\")"},
    {"keys": "M-x rexel-project-kill RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(string-match-p \"\\\\`Kill [0-9]+ buffers in \" (minibuffer-prompt))"}},
    {"type": "y"},
    {"wait": "until", "pred": "(string-match-p \"runs 1 command; destroy it\" (or (minibuffer-prompt) \"\"))"},
    {"type": "n"},
    {"wait": "idle", "min_idle": 0.5},
    {"assert": {"eval": "(and (null (get-buffer \"a.txt\")) (buffer-live-p rexel-elate-p2) (rexel-elate-on-server-p \"-proj\"))"}},

    {"group": "project-kill", "comment": "confirming both destroys the session with its programs; the other session stays"},
    {"eval": "(find-file (expand-file-name \"src/a.txt\" rexel-elate-root))"},
    {"keys": "M-x rexel-project-kill RET", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "y"},
    {"wait": "until", "pred": "(string-match-p \"runs 1 command; destroy it\" (or (minibuffer-prompt) \"\"))"},
    {"type": "y"},
    {"wait": "until", "pred": "(and (null (rexel-elate-blocks (concat rexel-elate-label \"-proj\"))) (not (rexel-elate-on-server-p \"-proj\")))"},
    {"assert": {"eval": "(and (rexel-elate-on-server-p \"-home\") (= 1 (length (rexel-elate-blocks))))"}},

    {"group": "project-kill-detached", "comment": "a session this Emacs is not attached to goes too, and asks when it runs a command"},
    {"eval": "(find-file (expand-file-name \"src/a.txt\" rexel-elate-root))"},
    {"keys": "M-x rexel-project RET"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-named-p \"1\" nil \"-proj\"))"},
    {"eval": "(rexel-elate-send \"sleep 300\\n\")"},
    {"wait": "until", "pred": "(buffer-local-value 'ghostel--command-running (rexel-elate-block))"},
    {"eval": "(with-current-buffer (rexel-elate-block) (rexel-detach))"},
    {"wait": "until", "pred": "(null (rexel-elate-blocks (concat rexel-elate-label \"-proj\")))"},
    {"assert": {"eval": "(rexel-elate-on-server-p \"-proj\")"}},
    {"eval": "(switch-to-buffer \"a.txt\")"},
    {"keys": "M-x rexel-project-kill RET", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "y"},
    {"wait": "until", "pred": "(string-match-p \"runs 1 command; destroy it\" (or (minibuffer-prompt) \"\"))"},
    {"type": "n"},
    {"wait": "idle", "min_idle": 0.5},
    {"assert": {"eval": "(rexel-elate-on-server-p \"-proj\")"}, "comment": "declining keeps the session"},
    {"eval": "(find-file (expand-file-name \"src/a.txt\" rexel-elate-root))"},
    {"keys": "M-x rexel-project-kill RET", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "y"},
    {"wait": "until", "pred": "(string-match-p \"runs 1 command; destroy it\" (or (minibuffer-prompt) \"\"))"},
    {"type": "y"},
    {"wait": "until", "pred": "(not (rexel-elate-on-server-p \"-proj\"))"},

    {"group": "project-kill-no-buffers", "comment": "a project without buffers to kill asks for its session alone"},
    {"eval": "(find-file (expand-file-name \"src/a.txt\" rexel-elate-root))"},
    {"keys": "M-x rexel-project RET"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (rexel-elate-named-p \"1\" nil \"-proj\"))"},
    {"eval": "(progn (kill-buffer \"a.txt\") (switch-to-buffer \"*scratch*\") (setq default-directory rexel-elate-root))"},
    {"keys": "M-x rexel-project-kill RET", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(string-match-p \"\\\\`Destroy Rex session \" (minibuffer-prompt))"}},
    {"type": "y"},
    {"wait": "until", "pred": "(not (rexel-elate-on-server-p \"-proj\"))"},

    {"group": "remote", "comment": "in a TRAMP directory M-x rexel uses the server labelled with the directory's host; the shell starts in the directory there, and default-directory follows it under the TRAMP prefix"},
    {"eval": "(progn (rexel-elate-use \"local\" \"unix\") (setq rexel-default-session (concat rexel-elate-label \"-far\")) (switch-to-buffer \"*scratch*\") (setq default-directory \"/usr/lib/\"))"},
    {"eval": "(let ((default-directory \"/ssh:unix:/usr/lib/\")) (rexel))"},
    {"wait": "until", "pred": "(and (rexel-elate-live-p) (equal \"unix\" (rexel--conn-host (buffer-local-value 'rexel--conn (rexel-elate-block)))) (rexel-elate-named-p \"1\" nil \"-far\"))"},
    {"type": "echo r0:$PWD"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r0:/usr/lib$\")"},
    {"eval": "(rexel-elate-shell)", "comment": "a shell that reports no directory itself: the relay's server is this machine, whose own reports name a local directory"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"type": "cd /usr/share"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(equal \"/ssh:unix:/usr/share/\" (buffer-local-value 'default-directory (rexel-elate-block)))", "timeout": 30},
    {"eval": "(switch-to-buffer \"*scratch*\")"},

    {"group": "remote-unknown", "comment": "a TRAMP directory on a machine without a known server is an error"},
    {"assert": {"eval": "(string-match-p \"No Rex server known for /ssh:nowhere:\" (condition-case err (let ((default-directory \"/ssh:nowhere:/tmp/\")) (rexel) \"\") (user-error (error-message-string err))))"}},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
