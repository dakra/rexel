{
  "name": "local",
  "comment": "What holds only for this machine's server: default-directory follows the shell, a running command is known from the processes Rex reports, and a local file given to the block has its own path typed instead of being copied.",
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(advice-add 'ghostel--osc133-marker :override #'ignore '((name . rexel-elate-no-osc133)))", "comment": "OSC 133 marks from the user's shell startup files go unseen: the block's shell counts as one without integration"},
    {"eval": "(rexel-elate-start \"local\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"assert": {"eval": "(null (rexel--conn-host rexel--conn))"}},
    {"assert": {"eval": "(string-match-p \"\\\\`\\\\*rex:[^@:]+:[^:*]+\\\\*\\\\'\" (buffer-name))"}, "comment": "no @HOST in the buffer name"},

    {"group": "directory", "comment": "default-directory follows the shell's working directory"},
    {"type": "cd /usr/share"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(equal default-directory \"/usr/share/\")", "timeout": 30},
    {"type": "cd /tmp"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(equal (file-truename default-directory) (file-truename \"/tmp/\"))", "timeout": 30},

    {"group": "command-running", "comment": "without shell integration, a running command is noticed from the processes Rex reports, and its end too"},
    {"wait": "until", "pred": "(not ghostel--command-running)", "timeout": 3, "comment": "the fresh shell is idle, also when Rex reported login in the foreground before it"},
    {"type": "sleep 2"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p \"^\\\\$ sleep 2$\" \"^\\\\$ ?$\")"},
    {"wait": "until", "pred": "(not ghostel--command-running)", "timeout": 15},
    {"assert": {"eval": "(equal (alist-get 'comm (process-attributes rexel--shell-pid)) \"bash\")"}, "comment": "the process taken for the shell is the shell"},
    {"type": "sleep 5"},
    {"keys": "RET"},
    {"wait": "until", "pred": "ghostel--command-running", "timeout": 10},
    {"assert": {"eval": "(ghostel-command-running-p)"}},
    {"wait": "until", "pred": "(not ghostel--command-running)", "timeout": 20},
    {"assert": {"eval": "(not (ghostel-command-running-p))"}},

    {"group": "upload-file", "comment": "C-c C-r u types the file's own path; nothing is stored on the server"},
    {"eval": "(setq f-local (rexel-elate-file \"local one.txt\" 5000) rexel-elate-stored (length (rexel-elate-uploads)))"},
    {"type": "cksum "},
    {"keys": "C-c C-r u", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer f-local)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-has (regexp-quote (shell-quote-argument f-local)))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-cksum-line f-local))"},
    {"assert": {"eval": "(and (not (rexel-elate-uploading-p)) (= rexel-elate-stored (length (rexel-elate-uploads))))"}},

    {"group": "remote-file", "comment": "a file on a TRAMP host has no path here, so it is uploaded like to any other server"},
    {"eval": "(setq f-remote (rexel-elate-file \"remote.txt\" 5000) rexel-elate-stored (length (rexel-elate-uploads)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file (list (rexel-elate-tramp-file f-remote)))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to \")", "timeout": 30},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-cksum-line f-remote))"},
    {"assert": {"eval": "(and (= (1+ rexel-elate-stored) (length (rexel-elate-uploads))) (not (rexel-elate-has \"/mock:\")))"}},
    {"eval": "(setq rexel-elate-stored (length (rexel-elate-uploads)))"},

    {"group": "drop", "comment": "dropped files have their paths typed in order"},
    {"eval": "(setq f-drop-a (rexel-elate-file \"drop-a.txt\" 5000) f-drop-b (rexel-elate-file \"drop b.txt\" 6000))"},
    {"type": "cksum "},
    {"eval": "(rexel-elate-drop (list f-drop-a f-drop-b))"},
    {"wait": "until", "pred": "(rexel-elate-has (regexp-quote (concat (shell-quote-argument f-drop-a) \" \" (shell-quote-argument f-drop-b))))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p (rexel-elate-cksum-line f-drop-a) (rexel-elate-cksum-line f-drop-b))"},

    {"group": "yank-media", "comment": "a pasted image is written to a temporary file whose path is typed"},
    {"type": "cksum "},
    {"eval": "(rexel-elate-yank-media 'image/png rexel-elate-png)"},
    {"wait": "until", "pred": "(rexel-elate-has \"cksum .*ghostel-clipboard-.*\\\\.png\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-png-line))"},
    {"assert": {"eval": "(= rexel-elate-stored (length (rexel-elate-uploads)))"}},

    {"group": "exec-shell", "comment": "a shell with integration that execs one without it: the end of a command is still noticed"},
    {"eval": "(advice-remove 'ghostel--osc133-marker 'rexel-elate-no-osc133)"},
    {"eval": "(rexel-elate-send (format \"source %s\\n\" (shell-quote-argument (expand-file-name \"etc/shell/ghostel.bash\" ghostel-module-directory))))"},
    {"wait": "until", "pred": "(ghostel-last-prompt)", "comment": "the shell sends OSC 133 marks"},
    {"type": "sleep 2"},
    {"keys": "RET"},
    {"wait": "until", "pred": "ghostel--command-running", "timeout": 5},
    {"wait": "until", "pred": "(not ghostel--command-running)", "timeout": 10},
    {"eval": "(rexel-elate-send \"exec bash --norc --noprofile\\nPS1='$ '\\n\")", "comment": "the same program under another argv0; Rex reports nothing else of an exec"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"type": "sleep 3"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p \"^\\\\$ sleep 3$\" \"^\\\\$ ?$\")", "comment": "the command ended"},
    {"wait": "until", "pred": "(not ghostel--command-running)", "timeout": 10},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
