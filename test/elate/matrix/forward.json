{
  "name": "forward",
  "comment": "Port forwards on a server reached under a label: the command and its prompts, connections relayed in both directions, links to localhost, what follows when a block starts and stops listening on a port, and the tunnel blocks on the server through a redial, a detach and the end of the block.  The server runs on this machine, so a forwarded port is taken here and the forward listens on another one; a small HTTP server in the block answers with its port.  For a reverse forward Emacs runs that HTTP server and curl is typed into the block; the port is taken on the server's machine too, so the server picks another.",
  "params": {"host": "unix"},
  "variants": {"unix": {"host": "unix"}, "tcp": {"host": "tcp"}},
  "requires": {"executable": ["curl", "python3"]},
  "defaults": {"timeout": 20},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(rexel-elate-start \"{{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"eval": "(setq f-a (rexel-elate--free-port) f-b (rexel-elate--free-port) f-c (rexel-elate--free-port) f-d (rexel-elate--free-port))"},
    {"assert": {"eval": "(= 4 (length (delete-dups (list f-a f-b f-c f-d))))"}},
    {"eval": "(make-directory rexel-elate-copies-dir t)"},
    {"wait": "until", "pred": "(listp rexel--ports)", "comment": "the ports the block has when it is attached to are known"},
    {"assert": {"eval": "(null rexel--ports)"}},

    {"group": "new-port", "comment": "a program that starts to listen on a port is named in the echo area, and nothing is forwarded"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-serve f-a)"},
    {"wait": "until", "pred": "(rexel-elate-messages-p (format \"rexel: .*: serve\\\\.py listens on port %d (.* forwards)\" f-a))"},
    {"assert": {"eval": "(and (rexel-elate-listed-p f-a) (null rexel--forwards))"}},

    {"group": "forward", "comment": "C-c C-r f forwards the block's one port without asking, shows the local URL and puts it in the kill ring; the server keeps a tunnel block that this client owns"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"keys": "C-c C-r f"},
    {"wait": "until", "pred": "(rexel-elate-forward f-a)"},
    {"assert": {"eval": "(rexel-elate-messages-p (format \"rexel: http://localhost:%d/ forwards to port %d on {{host}}\" (rexel-elate-local f-a) f-a))"}},
    {"assert": {"eval": "(equal (car kill-ring) (format \"http://localhost:%d/\" (rexel-elate-local f-a)))"}},
    {"assert": {"eval": "(/= f-a (rexel-elate-local f-a))"}, "comment": "the server's machine is this one, where the port is taken, so another one listens"},
    {"assert": {"eval": "(equal (rexel-elate-tunnels) (list (cons (format \"rexel %d:localhost:%d\" (rexel-elate-local f-a) f-a) (rexel--conn-client-id rexel--conn))))"}},
    {"assert": {"eval": "(= 1 (length (rexel--view-terminal-blocks (rexel-elate-view))))"}, "comment": "the session's view has the terminal alone"},
    {"eval": "(rexel-elate-get (rexel-elate-local f-a) \"/hello\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /hello$\" f-a))"},
    {"eval": "(rexel-port-forward)", "comment": "again: the port keeps its one forward"},
    {"wait": "until", "pred": "(rexel-elate-messages-p (format \"forwards to port %d on {{host}} \\\\[2 times\\\\]\" f-a))"},
    {"assert": {"eval": "(and (= 1 (length rexel--forwards)) (= 1 (length (rexel-elate-tunnels))))"}},

    {"group": "transfer", "comment": "3 MB arrive intact in both directions, and three downloads at a time"},
    {"eval": "(setq f-big (rexel-elate-file \"big.bin\" 3000000))"},
    {"eval": "(rexel-elate-get (rexel-elate-local f-a) (concat \"/file\" f-big) \"-o\" (rexel-elate-copy f-big))"},
    {"wait": "until", "pred": "(rexel-elate-curled)", "timeout": 60},
    {"assert": {"eval": "(rexel-elate-copied-p f-big)"}},
    {"eval": "(rexel-elate-get (rexel-elate-local f-a) \"/\" \"--data-binary\" (concat \"@\" f-big))"},
    {"wait": "until", "pred": "(rexel-elate-curled (concat \"^md5 \" (rexel-elate-md5 f-big) \"$\"))", "timeout": 60},
    {"eval": "(let ((url (format \"http://127.0.0.1:%d/file%s\" (rexel-elate-local f-a) f-big))) (rexel-elate-curl \"-Z\" url \"-o\" (concat (rexel-elate-copy f-big) \".1\") url \"-o\" (concat (rexel-elate-copy f-big) \".2\") url \"-o\" (concat (rexel-elate-copy f-big) \".3\")))"},
    {"wait": "until", "pred": "(rexel-elate-curled)", "timeout": 60},
    {"assert": {"eval": "(seq-every-p (lambda (n) (equal (rexel-elate-cksum f-big) (rexel-elate-cksum (format \"%s.%d\" (rexel-elate-copy f-big) n)))) (list 1 2 3))"}},
    {"wait": "until", "pred": "(null (rexel--forward-relays (rexel-elate-forward f-a)))", "comment": "no connection is left open"},

    {"group": "several", "comment": "with two ports the command reads one, and says which is forwarded"},
    {"eval": "(rexel-elate-serve f-b)"},
    {"wait": "until", "pred": "(rexel-elate-listed-p f-b)"},
    {"keys": "C-c C-r f", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Forward port: \")"},
    {"assert": {"eval": "(equal (sort (rexel-elate-choices) #'string<) (sort (list (format \"%d serve.py (forwarded)\" f-a) (format \"%d serve.py\" f-b)) #'string<))"}},
    {"eval": "(rexel-elate-answer (format \"%d serve.py\" f-b))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-forward f-b)"},
    {"eval": "(rexel-elate-get (rexel-elate-local f-b) \"/two\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /two$\" f-b))"},

    {"group": "target", "comment": "with a prefix argument the command reads a port, a host:port or a URL; a target nothing listens on yet is forwarded all the same"},
    {"keys": "C-u C-c C-r f", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Forward port, host:port or URL on {{host}}: \")"},
    {"eval": "(rexel-elate-answer \"nonsense\")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"Not a port, a host:port or a URL: nonsense\")"},
    {"keys": "C-u C-c C-r f", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Forward port, host:port or URL on {{host}}: \")"},
    {"eval": "(setq f-hold (make-network-process :name \"rexel-elate-hold\" :server t :host \"127.0.0.1\" :service f-c :family 'ipv4 :noquery t))", "comment": "the server's machine is this one: a forward listening on the free port itself would be its own target"},
    {"eval": "(rexel-elate-answer (format \"http://127.0.0.1:%d/x\" f-c))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-forward f-c)"},
    {"eval": "(delete-process f-hold)"},
    {"assert": {"eval": "(and (/= f-c (rexel-elate-local f-c)) (not (rexel-elate-listed-p f-c)))"}},
    {"eval": "(rexel-elate-get (rexel-elate-local f-c) \"/early\")"},
    {"wait": "until", "pred": "(rexel-elate-curl-failed-p)", "comment": "the target refuses: the connection ends without an answer"},
    {"assert": {"eval": "(rexel-elate-forward f-c)"}},
    {"eval": "(rexel-elate-serve f-c)"},
    {"wait": "until", "pred": "(rexel-elate-listed-p f-c)"},
    {"eval": "(rexel-elate-get (rexel-elate-local f-c) \"/late\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /late$\" f-c))"},

    {"group": "close", "comment": "rexel-port-forward-close reads one of the forwards and closes it here and on the server"},
    {"eval": "(setq f-lc (rexel-elate-local f-c))"},
    {"keys": "M-x rexel-port-forward-close RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Close forward: \")"},
    {"assert": {"eval": "(= 3 (length (rexel-elate-choices)))"}},
    {"eval": "(rexel-elate-answer (rexel--forward-describe (rexel-elate-forward f-c)))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(null (rexel-elate-forward f-c))"},
    {"assert": {"eval": "(rexel-elate-messages-p (format \"rexel: closed the forward to port %d on {{host}}\" f-c))"}},
    {"wait": "until", "pred": "(= 2 (length (rexel-elate-tunnels)))"},
    {"eval": "(rexel-elate-get f-lc \"/gone\")"},
    {"wait": "until", "pred": "(rexel-elate-curl-failed-p)", "comment": "nothing listens on the local port any more"},

    {"group": "link", "comment": "a link to localhost in the block opens on the local port of its forward, which is made when the port has none"},
    {"eval": "(setq rexel-elate-browsed nil)"},
    {"eval": "(rexel-elate-send (format \"echo http://localhost:%d/link-$((6*7))\\n\" f-b))"},
    {"wait": "until", "pred": "(rexel-elate-link \"/link-42\")"},
    {"eval": "(rexel-elate-open-link \"/link-42\")"},
    {"assert": {"eval": "(equal rexel-elate-browsed (list (format \"http://localhost:%d/link-42\" (rexel-elate-local f-b))))"}},
    {"eval": "(rexel-elate-send (format \"echo http://127.0.0.1:%d/new-$((6*7))?q=1\\n\" f-c))"},
    {"wait": "until", "pred": "(rexel-elate-link \"/new-42\")"},
    {"eval": "(rexel-elate-open-link \"/new-42\")"},
    {"wait": "until", "pred": "(rexel-elate-forward f-c)"},
    {"assert": {"eval": "(equal (car rexel-elate-browsed) (format \"http://127.0.0.1:%d/new-42?q=1\" (rexel-elate-local f-c)))"}},
    {"eval": "(rexel-elate-curl (car rexel-elate-browsed))"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /new-42\\\\?q=1$\" f-c))"},
    {"eval": "(rexel-elate-send \"echo https://example.com/other-$((6*7))\\n\")"},
    {"wait": "until", "pred": "(rexel-elate-link \"/other-42\")"},
    {"eval": "(rexel-elate-open-link \"/other-42\")"},
    {"assert": {"eval": "(equal (car rexel-elate-browsed) \"https://example.com/other-42\")"}, "comment": "other links are left alone"},
    {"eval": "(setq rexel-port-forward-links nil)"},
    {"eval": "(rexel-elate-open-link \"/link-42\")"},
    {"assert": {"eval": "(equal (car rexel-elate-browsed) (format \"http://localhost:%d/link-42\" f-b))"}, "comment": "and so are all with the option off"},
    {"eval": "(setq rexel-port-forward-links t)"},

    {"group": "click", "comment": "a click on the link in a window that is not selected selects the window and opens the link through the forward"},
    {"eval": "(rexel-elate-send (format \"clear; echo http://localhost:%d/click-$((6*7))\\n\" f-b))"},
    {"wait": "until", "pred": "(and (rexel-elate-link \"/click-42\") (not (rexel-elate-shows \"link-42\")))"},
    {"eval": "(with-current-buffer (rexel-elate-block) (rename-buffer \"*rexel-forward*\"))"},
    {"eval": "(progn (select-window (split-window)) (switch-to-buffer \"*scratch*\") (setq rexel-elate-browsed nil))"},
    {"assert": {"eval": "(not (rexel-block-p))"}},
    {"wait": "until", "pred": "(rexel-elate-link \"/click-42\")", "comment": "the split resized the terminal, which redraws it"},
    {"send_events": ["down-mouse-1@1,20"], "buffer": "*rexel-forward*"},
    {"wait": "idle", "min_idle": 0.1, "comment": "a press and its release take time"},
    {"send_events": ["mouse-1@1,20"], "buffer": "*rexel-forward*"},
    {"wait": "until", "pred": "(equal rexel-elate-browsed (list (format \"http://localhost:%d/click-42\" (rexel-elate-local f-b))))"},
    {"assert": {"eval": "(rexel-block-p)"}, "comment": "the press selected the block's window"},
    {"eval": "(progn (delete-other-windows (get-buffer-window \"*rexel-forward*\")) (select-window (get-buffer-window \"*rexel-forward*\")))"},

    {"group": "port-closes", "comment": "when the block stops listening, the forward closes; it opens again on the same local port when the block listens again"},
    {"eval": "(setq f-la (rexel-elate-local f-a))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-serve-stop f-a)"},
    {"wait": "until", "pred": "(null (rexel-elate-forward f-a))"},
    {"assert": {"eval": "(rexel-elate-messages-p (format \"rexel: .*: port %d closed, and its forward\" f-a))"}},
    {"assert": {"eval": "(equal rexel--forward-remembered (list (cons f-a f-la)))"}},
    {"wait": "until", "pred": "(= 2 (length (rexel-elate-tunnels)))"},
    {"eval": "(rexel-elate-get f-la \"/closed\")"},
    {"wait": "until", "pred": "(rexel-elate-curl-failed-p)"},
    {"eval": "(rexel-elate-serve f-a)"},
    {"wait": "until", "pred": "(rexel-elate-forward f-a)"},
    {"assert": {"eval": "(and (= f-la (rexel-elate-local f-a)) (null rexel--forward-remembered))"}},
    {"eval": "(rexel-elate-get f-la \"/again\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /again$\" f-a))"},

    {"group": "port-closes-options", "comment": "with `close' the forward stays closed, with `keep' it stays open"},
    {"eval": "(setq rexel-port-forward-when-port-closes 'close)"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-serve-stop f-a)"},
    {"wait": "until", "pred": "(null (rexel-elate-forward f-a))"},
    {"eval": "(rexel-elate-serve f-a)"},
    {"wait": "until", "pred": "(rexel-elate-messages-p (format \"serve\\\\.py listens on port %d\" f-a))"},
    {"assert": {"eval": "(and (null (rexel-elate-forward f-a)) (null rexel--forward-remembered))"}},
    {"eval": "(setq rexel-port-forward-when-port-closes 'keep)"},
    {"eval": "(rexel-elate-serve-stop f-b)"},
    {"wait": "until", "pred": "(not (rexel-elate-listed-p f-b))"},
    {"assert": {"eval": "(rexel-elate-forward f-b)"}},
    {"eval": "(rexel-elate-serve f-b)"},
    {"wait": "until", "pred": "(rexel-elate-listed-p f-b)"},
    {"eval": "(rexel-elate-get (rexel-elate-local f-b) \"/kept\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /kept$\" f-b))"},
    {"eval": "(setq rexel-port-forward-when-port-closes 'remember)"},

    {"group": "forward-new-ports", "comment": "with rexel-port-forward-new-ports t a new port is forwarded at once"},
    {"eval": "(setq rexel-port-forward-new-ports t)"},
    {"eval": "(rexel-elate-serve f-d)"},
    {"wait": "until", "pred": "(rexel-elate-forward f-d)"},
    {"eval": "(rexel-elate-get (rexel-elate-local f-d) \"/auto\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /auto$\" f-d))"},
    {"eval": "(setq rexel-port-forward-new-ports 'message)"},

    {"group": "reverse", "comment": "C-c C-r F reads a target on this machine; the server listens on a port of its machine, whose URL is shown and put in the kill ring, and a curl in the block reaches the target"},
    {"eval": "(setq f-r (rexel-elate--free-port))"},
    {"eval": "(rexel-elate-serve-here f-r)"},
    {"wait": "until", "pred": "(rexel-elate-listening-p f-r)"},
    {"eval": "(setq f-count (length (rexel-elate-tunnels)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"keys": "C-c C-r F", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Forward from {{host}} to port, host:port or URL: \")"},
    {"eval": "(rexel-elate-answer (number-to-string f-r))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-forward f-r t)"},
    {"assert": {"eval": "(/= f-r (rexel-elate-remote f-r))"}, "comment": "the server's machine is this one, where the target holds the port, so the server picked another"},
    {"assert": {"eval": "(rexel-elate-messages-p (format \"rexel: port %d on {{host}} forwards to port %d here\" (rexel-elate-remote f-r) f-r))"}},
    {"assert": {"eval": "(equal (car kill-ring) (format \"http://localhost:%d/\" (rexel-elate-remote f-r)))"}},
    {"assert": {"eval": "(member (cons (format \"rexel -R 0:localhost:%d\" f-r) (rexel--conn-client-id rexel--conn)) (rexel-elate-tunnels))"}},
    {"assert": {"eval": "(= (1+ f-count) (length (rexel-elate-tunnels)))"}},
    {"assert": {"eval": "(= 1 (length (rexel--view-terminal-blocks (rexel-elate-view))))"}},
    {"eval": "(rexel-elate-block-curl \"r1\" (rexel-elate-remote f-r) \"/rev-$((6*7))\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r1=0$\")"},
    {"assert": {"eval": "(rexel-elate-has (format \"^served %d /rev-42$\" f-r))"}},
    {"eval": "(rexel-port-forward-reverse f-r)", "comment": "again: the target keeps its one reverse forward"},
    {"assert": {"eval": "(= (1+ f-count) (length rexel--forwards) (length (rexel-elate-tunnels)))"}},

    {"group": "reverse-transfer", "comment": "3 MB arrive intact in both directions"},
    {"eval": "(setq f-big (rexel-elate-file \"big.bin\" 3000000))"},
    {"eval": "(ignore-errors (delete-file (rexel-elate-copy f-big)))"},
    {"eval": "(rexel-elate-block-curl \"r2\" (rexel-elate-remote f-r) (concat \"/file\" f-big) \"-o\" (rexel-elate-copy f-big))"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r2=[0-9]+$\")", "timeout": 60},
    {"assert": {"eval": "(and (rexel-elate-has \"^r2=0$\") (rexel-elate-copied-p f-big))"}},
    {"eval": "(rexel-elate-block-curl \"r3\" (rexel-elate-remote f-r) \"/\" \"--data-binary\" (concat \"@\" f-big))"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r3=[0-9]+$\")", "timeout": 60},
    {"assert": {"eval": "(rexel-elate-has (concat \"^md5 \" (rexel-elate-md5 f-big) \"$\"))"}},
    {"wait": "until", "pred": "(null (rexel--forward-relays (rexel-elate-forward f-r t)))", "comment": "no connection is left open"},

    {"group": "reverse-target", "comment": "while nothing listens on the target, a connection to the server's port ends at once without an answer; the forward stays and works once the target is back"},
    {"eval": "(rexel-elate-serve-here-stop f-r)"},
    {"wait": "until", "pred": "(not (rexel-elate-listening-p f-r))"},
    {"eval": "(rexel-elate-block-curl \"r4\" (rexel-elate-remote f-r) \"/down\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r4=[0-9]+$\")", "timeout": 10},
    {"assert": {"eval": "(and (not (rexel-elate-has \"^r4=0$\")) (rexel-elate-forward f-r t))"}},
    {"wait": "until", "pred": "(null (rexel--forward-relays (rexel-elate-forward f-r t)))"},
    {"eval": "(rexel-elate-serve-here f-r)"},
    {"wait": "until", "pred": "(rexel-elate-listening-p f-r)"},
    {"eval": "(rexel-elate-block-curl \"r5\" (rexel-elate-remote f-r) \"/back-$((6*7))\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r5=0$\")"},
    {"assert": {"eval": "(rexel-elate-has (format \"^served %d /back-42$\" f-r))"}},

    {"group": "redial", "comment": "after the control connection dropped, the tunnels are taken back and the forwards work"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(setq f-count (length rexel--forwards) f-rr (rexel-elate-remote f-r))"},
    {"eval": "(rexel-elate-drop-connection 'control)"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")"},
    {"wait": "until", "pred": "(ignore-errors (let ((tunnels (rexel-elate-tunnels))) (and tunnels (seq-every-p (lambda (tunnel) (equal (cdr tunnel) (rexel--conn-client-id rexel--conn))) tunnels))))"},
    {"assert": {"eval": "(= f-count (length rexel--forwards) (length (rexel-elate-tunnels)))"}},
    {"eval": "(rexel-elate-get (rexel-elate-local f-b) \"/redial\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /redial$\" f-b))"},

    {"group": "relay-restart", "comment": "the whole path dies and returns: a new client takes the tunnels over and the forwards work on their local ports"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-elate-relay-stop '{{host}})"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: connection to {{host}} lost, reconnecting\")"},
    {"wait": "idle", "min_idle": 2, "timeout": 10},
    {"eval": "(rexel-elate-relay-start '{{host}})"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: \\\\(reconnected\\\\|re-attached as a new client\\\\) to {{host}}\")", "timeout": 45},
    {"wait": "until", "pred": "(rexel-elate-live-p)", "timeout": 20},
    {"wait": "until", "pred": "(ignore-errors (let ((tunnels (rexel-elate-tunnels))) (and tunnels (seq-every-p (lambda (tunnel) (equal (cdr tunnel) (rexel--conn-client-id rexel--conn))) tunnels))))", "timeout": 20},
    {"assert": {"eval": "(= f-count (length rexel--forwards) (length (rexel-elate-tunnels)))"}},
    {"eval": "(rexel-elate-get (rexel-elate-local f-d) \"/restart\")"},
    {"wait": "until", "pred": "(rexel-elate-curled (format \"^served %d /restart$\" f-d))"},

    {"group": "reverse-redial", "comment": "the reverse forward's tunnel was taken back with the others: the server listens on the same port, and a connection to it reaches the target"},
    {"assert": {"eval": "(= f-rr (rexel-elate-remote f-r))"}},
    {"eval": "(rexel-elate-block-curl \"r6\" f-rr \"/redialled-$((6*7))\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r6=0$\")"},
    {"assert": {"eval": "(rexel-elate-has (format \"^served %d /redialled-42$\" f-r))"}},

    {"group": "reverse-close", "comment": "rexel-port-forward-close lists the forwards of both directions, and closing the reverse one frees the port on the server's machine"},
    {"keys": "M-x rexel-port-forward-close RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Close forward: \")"},
    {"assert": {"eval": "(and (= (length rexel--forwards) (length (rexel-elate-choices))) (member (format \"port %d on {{host}} forwards to port %d here\" f-rr f-r) (rexel-elate-choices)) (member (rexel--forward-describe (rexel-elate-forward f-b)) (rexel-elate-choices)))"}},
    {"eval": "(rexel-elate-answer (format \"port %d on {{host}} forwards to port %d here\" f-rr f-r))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(null (rexel-elate-forward f-r t))"},
    {"assert": {"eval": "(rexel-elate-messages-p (format \"rexel: closed the reverse forward from port %d on {{host}}\" f-rr))"}},
    {"wait": "until", "pred": "(= (length rexel--forwards) (length (rexel-elate-tunnels)))"},
    {"eval": "(rexel-elate-block-curl \"r7\" f-rr \"/closed\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^r7=7$\")", "comment": "nothing listens on the server's port any more"},

    {"group": "detach", "comment": "detaching closes the session's forwards on the server; attaching again closes a tunnel a rexel left behind without an owner"},
    {"eval": "(rexel-elate-leave-tunnel \"rexel 1:localhost:9\")"},
    {"wait": "until", "pred": "(member (list \"rexel 1:localhost:9\") (rexel-elate-tunnels))"},
    {"eval": "(rexel-port-forward-reverse f-r)"},
    {"wait": "until", "pred": "(rexel-elate-forward f-r t)"},
    {"eval": "(setq f-conn rexel--conn f-sid rexel--session-id f-lb (rexel-elate-local f-b) f-rr (rexel-elate-remote f-r))"},
    {"eval": "(rexel-detach)"},
    {"assert": {"eval": "(and (null rexel--forwards) (null (rexel-elate-blocks)))"}},
    {"eval": "(rexel-elate-get f-lb \"/detached\")"},
    {"wait": "until", "pred": "(rexel-elate-curl-failed-p)"},
    {"wait": "until", "pred": "(not (rexel-elate-listening-p f-rr))", "comment": "the server's port of the reverse forward is closed too"},
    {"eval": "(progn (rexel-elate-clear-messages) (setq rexel-port-forward-new-ports t))", "comment": "a port taken for new would be forwarded"},
    {"eval": "(rexel--attach-session f-conn f-sid)"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(switch-to-buffer (rexel-elate-block))"},
    {"wait": "until", "pred": "(null (rexel-elate-tunnels))"},
    {"wait": "until", "pred": "(listp rexel--ports)"},
    {"assert": {"eval": "(and rexel--ports (null rexel--forwards) (not (rexel-elate-messages-p \"listens on port\")))"}, "comment": "the ports that are open at an attach are not forwarded or named"},
    {"eval": "(setq rexel-port-forward-new-ports 'message)"},

    {"group": "exit", "comment": "rexel--forwards-leave, which an exiting Emacs runs before it leaves its servers, closes the tunnels"},
    {"eval": "(rexel-port-forward f-b)"},
    {"wait": "until", "pred": "(rexel-elate-forward f-b)"},
    {"assert": {"eval": "(= 1 (length (rexel-elate-tunnels)))"}},
    {"eval": "(rexel--forwards-leave)"},
    {"assert": {"eval": "(and (null rexel--forwards) (null (rexel-elate-tunnels)))"}},

    {"group": "kill-buffer", "comment": "killing the block's buffer closes its forwards with the block, and the session, then empty, is destroyed"},
    {"eval": "(rexel-port-forward f-b)"},
    {"wait": "until", "pred": "(rexel-elate-forward f-b)"},
    {"eval": "(rexel-elate-send (format \"pkill -f serve.py; echo k-$((6*7))\\n\"))"},
    {"wait": "until", "pred": "(rexel-elate-has \"^k-42$\")"},
    {"eval": "(kill-buffer (rexel-elate-block))"},
    {"assert": {"eval": "(null rexel--forwards)"}},
    {"wait": "until", "pred": "(not (rexel-elate-on-server-p))"},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
