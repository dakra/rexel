{
  "name": "download",
  "comment": "Files copied from a block's machine with rexel-download-file, on this machine's server and on one reached under a label: through the command's prompts and from Lisp, with the edge cases of sizes, names, relative paths, existing files and refusals.  The server runs on this machine, so `cksum' compares a file with its copy.",
  "params": {"host": "unix"},
  "variants": {
    "local": {"host": "local"},
    "unix": {"host": "unix"},
    "tcp": {"host": "tcp"},
    "tls": {"host": "tls"}
  },
  "defaults": {"timeout": 20},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(rexel-elate-start \"{{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"eval": "(make-directory rexel-elate-copies-dir t)"},

    {"group": "download-file", "comment": "the command reads the file and where to save it; a directory gets a file of the same name"},
    {"eval": "(setq f-one (rexel-elate-file \"one.txt\" 10000))"},
    {"keys": "M-x rexel-download-file RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Download file\")"},
    {"eval": "(rexel-elate-answer f-one)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Save as: \")"},
    {"assert": {"eval": "(string-suffix-p \"/one.txt\" (with-selected-window (active-minibuffer-window) (minibuffer-contents)))"}, "comment": "the file's name is offered"},
    {"eval": "(rexel-elate-answer rexel-elate-copies-dir)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: downloaded .*copies/one\\\\.txt\")"},
    {"assert": {"eval": "(rexel-elate-copied-p f-one)"}},

    {"group": "overwrite", "comment": "an existing file is replaced only after a yes"},
    {"eval": "(rexel-elate-file \"one.txt\" 500)"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"keys": "M-x rexel-download-file RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Download file\")"},
    {"eval": "(rexel-elate-answer f-one)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Save as: \")"},
    {"eval": "(rexel-elate-answer (rexel-elate-copy f-one))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"File .*one\\\\.txt already exists; overwrite it\")"},
    {"keys": "n", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"Not downloaded\")"},
    {"assert": {"eval": "(= 10000 (file-attribute-size (file-attributes (rexel-elate-copy f-one))))"}},
    {"keys": "M-x rexel-download-file RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Download file\")"},
    {"eval": "(rexel-elate-answer f-one)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Save as: \")"},
    {"eval": "(rexel-elate-answer (rexel-elate-copy f-one))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"File .*one\\\\.txt already exists; overwrite it\")"},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: downloaded .*copies/one\\\\.txt\")"},
    {"assert": {"eval": "(rexel-elate-copied-p f-one)"}},

    {"group": "sizes", "comment": "an empty file, one byte and sizes around the 32768 bytes a message carries arrive intact, several at a time"},
    {"eval": "(setq f-sizes (mapcar (lambda (n) (rexel-elate-file (format \"size-%d.bin\" n) n)) (list 0 1 32767 32768 32769 200000)))"},
    {"eval": "(dolist (f f-sizes) (rexel-download-file f (rexel-elate-copy f)))"},
    {"wait": "until", "pred": "(seq-every-p #'rexel-elate-copied-p f-sizes)"},

    {"group": "names", "comment": "names with spaces, shell characters and non-ASCII ones arrive under the name given"},
    {"eval": "(setq f-names (mapcar (lambda (n) (rexel-elate-file n 1000)) (list \"my file (1).txt\" \"d$HOME`x`.txt\" \"über ü 日本.txt\" \"-dash.txt\" \"star*?[a].txt\")))"},
    {"eval": "(dolist (f f-names) (rexel-download-file f (rexel-elate-copy f)))"},
    {"wait": "until", "pred": "(seq-every-p #'rexel-elate-copied-p f-names)"},

    {"group": "compressed", "comment": "a compressed file arrives as it is on disk"},
    {"eval": "(setq f-gz (rexel-elate-gz-file \"packed.txt\" 20000))"},
    {"eval": "(rexel-download-file f-gz (rexel-elate-copy f-gz))"},
    {"wait": "until", "pred": "(rexel-elate-copied-p f-gz)"},

    {"group": "relative", "comment": "a relative path is one in the directory of the block's shell"},
    {"eval": "(setq f-inner (rexel-elate-file \"sub/inner.txt\" 3000))"},
    {"eval": "(rexel-elate-send (format \"cd %s && echo cd-$((6*7))\\n\" (shell-quote-argument rexel-elate-files-dir)))"},
    {"wait": "until", "pred": "(rexel-elate-has \"^cd-42\")"},
    {"eval": "(rexel-download-file \"sub/inner.txt\" (rexel-elate-copy f-inner))"},
    {"wait": "until", "pred": "(rexel-elate-copied-p f-inner)"},

    {"group": "complete", "comment": "the path is read with completion, starting in the directory of the block's shell"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"keys": "M-x rexel-download-file RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Download file: \")"},
    {"assert": {"eval": "(equal (file-name-as-directory (file-truename rexel-elate-files-dir)) (with-selected-window (active-minibuffer-window) (minibuffer-contents)))"}},
    {"keys": "s u TAB i n TAB", "delivery": "events"},
    {"wait": "until", "pred": "(string-suffix-p \"/sub/inner.txt\" (with-selected-window (active-minibuffer-window) (minibuffer-contents)))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-asks-p \"Save as: \")"},
    {"eval": "(rexel-elate-answer (expand-file-name \"completed.txt\" rexel-elate-copies-dir))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: downloaded .*copies/completed\\\\.txt\")"},
    {"assert": {"eval": "(= 3000 (file-attribute-size (file-attributes (expand-file-name \"completed.txt\" rexel-elate-copies-dir))))"}},

    {"group": "refusals", "comment": "a missing file and a directory are reported and leave nothing behind"},
    {"eval": "(setq d-count (length (directory-files rexel-elate-copies-dir)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(rexel-download-file \"no-such-file.txt\" (expand-file-name \"none.txt\" rexel-elate-copies-dir))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: download of no-such-file\\\\.txt failed: not found\")"},
    {"eval": "(rexel-download-file \"sub\" (expand-file-name \"sub.txt\" rexel-elate-copies-dir))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: download of sub failed: not a regular file\")"},
    {"assert": {"eval": "(= d-count (length (directory-files rexel-elate-copies-dir)))"}},

    {"group": "large", "comment": "30 MB arrive intact"},
    {"eval": "(setq f-large (rexel-elate-sparse-file \"large.bin\" 30000000))"},
    {"eval": "(rexel-download-file f-large (rexel-elate-copy f-large))"},
    {"wait": "until", "pred": "(file-exists-p (rexel-elate-copy f-large))", "timeout": 60},
    {"assert": {"eval": "(rexel-elate-copied-p f-large)"}},

    {"group": "visit", "comment": "with a prefix argument the copy is visited"},
    {"eval": "(rexel-download-file f-inner (expand-file-name \"visit.txt\" rexel-elate-copies-dir) t)"},
    {"wait": "until", "pred": "(equal (buffer-file-name (window-buffer)) (expand-file-name \"visit.txt\" rexel-elate-copies-dir))"},
    {"assert": {"eval": "(= 3000 (buffer-size (window-buffer)))"}},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
