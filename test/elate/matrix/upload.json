{
  "name": "upload",
  "comment": "Files sent to a block on a server reached under a label, as one on another machine is: through rexel-upload-file, Dired, a drop and a pasted image, with the edge cases of sizes, names, slow and stalled transfers, changing files and cancelling.  The block's shell is the oracle: `cksum' waits at the prompt, Rex types the stored paths after it, and its output is compared with the local files.",
  "params": {"host": "unix"},
  "variants": {
    "unix": {"host": "unix"},
    "tcp": {"host": "tcp"},
    "tls": {"host": "tls"}
  },
  "defaults": {"timeout": 20},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(rexel-elate-start \"{{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},

    {"group": "upload-file", "comment": "C-c C-r u reads a file, uploads it and has its path typed"},
    {"eval": "(setq f-one (rexel-elate-file \"one.txt\" 10000))"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"keys": "C-c C-r u", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Upload file: "}}},
    {"eval": "(rexel-elate-answer f-one)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")"},
    {"assert": {"eval": "(and (not (rexel-elate-uploading-p)) (= 1 (length (rexel-elate-uploads))))"}},
    {"wait": "until", "pred": "(rexel-elate-has \"cksum .*one\\\\.txt\")", "comment": "the path is typed, not yet run"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-cksum-line f-one))"},

    {"group": "several", "comment": "files sent together are typed together, in order; names with spaces are quoted"},
    {"eval": "(setq f-two (rexel-elate-file \"two.bin\" 70000) f-space (rexel-elate-file \"my file (1).txt\" 3000))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file (list f-two f-space))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 2 files to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p (rexel-elate-cksum-line f-two) (rexel-elate-cksum-line f-space))"},

    {"group": "empty", "comment": "an empty file arrives empty"},
    {"eval": "(setq f-empty (rexel-elate-file \"empty.dat\" 0))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file (list f-empty))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^4294967295 0 .*empty\\\\.dat$\")"},

    {"group": "boundaries", "comment": "files of one byte and around the 4096-byte chunk an upload message carries arrive intact"},
    {"eval": "(setq f-sizes (mapcar (lambda (n) (rexel-elate-file (format \"size-%d.bin\" n) n)) (list 1 4095 4096 4097 8192 65536)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file f-sizes)"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 6 files to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(apply #'rexel-elate-in-order-p (mapcar #'rexel-elate-cksum-line f-sizes))"},

    {"group": "symlink", "comment": "a symlink arrives with the content of the file it points to"},
    {"eval": "(setq f-target (rexel-elate-file \"target.txt\" 5000) f-link (expand-file-name \"link.txt\" rexel-elate-files-dir))"},
    {"eval": "(make-symbolic-link f-target f-link t)"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file (list f-link))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (format \"^%s .*link\\\\.txt$\" (rexel-elate-cksum f-target)))"},

    {"group": "names", "comment": "names the shell must quote, and non-ASCII ones, are typed quoted and arrive under their own names"},
    {"eval": "(setq f-names (mapcar (lambda (n) (rexel-elate-file n 1000)) (list \"d$HOME`x`.txt\" \"q'uo\\\"te.txt\" \"über ü 日本.txt\" \"-dash.txt\" \"star*?[a].txt\")))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file f-names)"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 5 files to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(apply #'rexel-elate-in-order-p (mapcar #'rexel-elate-cksum-line f-names))"},

    {"group": "compressed", "comment": "a compressed file arrives as it is on disk"},
    {"eval": "(setq f-gz (rexel-elate-gz-file \"packed.txt\" 20000))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file (list f-gz))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^[0-9]+ [0-9]+ .*packed\\\\.txt\\\\.gz$\")"},
    {"assert": {"eval": "(rexel-elate-has (rexel-elate-cksum-line f-gz))"}},

    {"group": "dnd", "comment": "files dropped on the window (X11 and pgtk dispatch, one call per file) share a batch"},
    {"eval": "(setq f-dnd-a (rexel-elate-file \"dnd-a.txt\" 5000) f-dnd-b (rexel-elate-file \"dnd-b.txt\" 6000))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-elate-dnd (list f-dnd-a f-dnd-b))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 2 files to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p (rexel-elate-cksum-line f-dnd-a) (rexel-elate-cksum-line f-dnd-b))"},

    {"group": "drop", "comment": "a drag-n-drop event (NS and w32) through the command loop"},
    {"eval": "(setq f-drop-a (rexel-elate-file \"drop-a.txt\" 5000) f-drop-b (rexel-elate-file \"drop b.txt\" 6000))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-elate-drop (list f-drop-a f-drop-b))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 2 files to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p (rexel-elate-cksum-line f-drop-a) (rexel-elate-cksum-line f-drop-b))"},

    {"group": "yank-media", "comment": "an image pasted with yank-media is uploaded"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-elate-yank-media 'image/png rexel-elate-png)"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-png-line))"},

    {"group": "dired", "comment": "in Dired, rexel-upload-file sends the marked files to a block read from the minibuffer"},
    {"eval": "(setq f-dired-a (rexel-elate-file \"dired-a.txt\" 4000) f-dired-b (rexel-elate-file \"dired-b.txt\" 6000))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(progn (setq rexel-elate-target (buffer-name (rexel-elate-block))) (dired-other-window (file-name-directory f-dired-a)) (dired-mark-files-regexp \"\\\\`dired-\"))"},
    {"keys": "M-x rexel-upload-file RET", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(rexel-elate-answer rexel-elate-target)"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 2 files to {{host}}\")"},
    {"eval": "(progn (select-window (get-buffer-window rexel-elate-target)) (delete-other-windows))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p (rexel-elate-cksum-line f-dired-a) (rexel-elate-cksum-line f-dired-b))"},

    {"group": "seventeen", "comment": "more than 16 files go in rounds; every path is typed, in order"},
    {"eval": "(setq f-many (rexel-elate-files 17 2000))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file f-many)"},
    {"wait": "until", "pred": "(and (rexel-elate-messages-p \"rexel: uploaded 16 files to {{host}}\") (rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\") (not (rexel-elate-uploading-p)))", "timeout": 40},
    {"keys": "RET"},
    {"wait": "until", "pred": "(= 17 (rexel-elate-count \"^[0-9]+ 2000 .*many-[0-9][0-9]\\\\.txt$\"))"},
    {"assert": {"eval": "(apply #'rexel-elate-in-order-p (mapcar #'rexel-elate-cksum-line f-many))"}},

    {"group": "remote-file", "comment": "a file on a TRAMP host is fetched, sent and typed, also as the first of a batch following another, and the temporary copy goes"},
    {"eval": "(setq f-remote (rexel-elate-file \"remote.txt\" 70000) f-many (rexel-elate-files 16 2000))"},
    {"eval": "(setq rexel-elate-copies (length (directory-files temporary-file-directory nil \"\\\\`tramp\\\\.\")))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(rexel-upload-file (append f-many (list (rexel-elate-tramp-file f-remote))))"},
    {"wait": "until", "pred": "(and (rexel-elate-messages-p \"rexel: uploaded 16 files to {{host}}\") (rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\") (not (rexel-elate-uploading-p)))", "timeout": 30},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-cksum-line f-remote))"},
    {"assert": {"eval": "(= rexel-elate-copies (length (directory-files temporary-file-directory nil \"\\\\`tramp\\\\.\")))"}},

    {"group": "not-a-file", "comment": "a directory or a missing file is refused before anything is sent"},
    {"assert": {"eval": "(condition-case nil (progn (rexel-upload-file (list temporary-file-directory)) nil) (user-error t))"}},
    {"assert": {"eval": "(condition-case nil (progn (rexel-upload-file (list \"/tmp/rexel-elate-no-such-file\")) nil) (user-error t))"}},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},

    {"group": "too-large", "comment": "a file over the server's limit is refused with the server's message and nothing is typed"},
    {"eval": "(setq f-big (rexel-elate-sparse-file \"too-large.bin\" (1+ (* 100 1024 1024))))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "echo u-large-$((5*5)) "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ echo u-large-\")"},
    {"eval": "(rexel-upload-file (list f-big))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: too-large\\\\.bin: .*too_large\")"},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"u-large-25$\")", "comment": "no path after it; not anchored at the line start, as a resize from a long message makes bash redraw the line"},

    {"group": "stays-usable", "comment": "during a large upload Emacs runs timers, takes keys and reads process output, and the file arrives intact"},
    {"eval": "(setq f-large (rexel-elate-sparse-file \"large.bin\" (* 60 1024 1024)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(progn (rexel-elate-ticker-start) (rexel-elate-output-ticker-start) (rexel-elate-key-probe-arm) (rexel-upload-file (list f-large)))"},
    {"keys": "M-x rexel-elate-key-probe RET", "delivery": "raw", "comment": "typed on the terminal, read by the command loop"},
    {"wait": "until", "pred": "(rexel-elate-key-latency)", "timeout": 60},
    {"assert": {"eval": "(and rexel-elate-key-uploading (< (rexel-elate-key-latency) 1.0))"}, "comment": "the key ran within a second, while the file was on its way"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")", "timeout": 180},
    {"assert": {"eval": "(< (rexel-elate-ticker-stop) 1.0)"}, "comment": "no timer waited a second"},
    {"assert": {"eval": "(< (rexel-elate-output-ticker-stop) 1.5)"}, "comment": "a process printing every 100 ms was read at least every 1.5 s"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-cksum-line f-large))", "timeout": 60},

    {"group": "slow", "comment": "an upload that sends nothing for longer than the keep-alive interval stays open: the ping on its connection is answered and the file arrives intact"},
    {"eval": "(progn (setq rexel--keepalive-interval 2 rexel--connect-timeout 2) (rexel--keepalive))"},
    {"eval": "(setq f-slow (rexel-elate-file \"slow.txt\" 300000))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(progn (rexel-elate-hold-upload 100000) (rexel-upload-file (list f-slow)))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)"},
    {"eval": "(setq rexel-elate-held-at (float-time))"},
    {"wait": "until", "pred": "(> (process-get (websocket-conn (rexel--upload-ws (car rexel--uploads))) :last-read) (+ rexel-elate-held-at 2))", "comment": "the keep-alive pinged the silent connection and the server answered"},
    {"wait": "until", "pred": "(> (float-time) (+ rexel-elate-held-at 7))", "comment": "longer than a probe waits for its answer"},
    {"assert": {"eval": "(and (rexel-elate-uploading-p) (not (rexel-elate-messages-p \"upload failed\")))"}},
    {"eval": "(rexel-elate-release-upload)"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 1 file to {{host}}\")"},
    {"eval": "(setq rexel--keepalive-interval 30 rexel--connect-timeout 10)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-cksum-line f-slow))"},

    {"group": "file-changes", "comment": "a file that shrinks or disappears during its upload fails the batch with a message and nothing is typed"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "echo u-changed-$((4*4)) "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ echo u-changed-\")"},
    {"eval": "(progn (setq f-shrink (rexel-elate-file \"shrink.txt\" 300000)) (rexel-elate-hold-upload 100000) (rexel-upload-file (list f-shrink)))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)"},
    {"eval": "(progn (with-temp-file f-shrink (insert \"short\\n\")) (rexel-elate-release-upload))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: shrink\\\\.txt: File changed during the upload\")"},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},
    {"eval": "(progn (setq f-gone (rexel-elate-file \"gone.txt\" 300000)) (rexel-elate-hold-upload 100000) (rexel-upload-file (list f-gone)))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)"},
    {"eval": "(progn (delete-file f-gone) (rexel-elate-release-upload))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: gone\\\\.txt: \")"},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"u-changed-16$\")", "comment": "no path after it; not anchored at the line start, as a resize from a long message makes bash redraw the line"},

    {"group": "cancel", "comment": "rexel-cancel-upload stops a batch halfway through a file: nothing is typed and the server drops what it had stored"},
    {"eval": "(setq rexel-elate-stored (length (rexel-elate-uploads)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "echo u-cancel-$((3*3)) "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ echo u-cancel-\")"},
    {"eval": "(progn (rexel-elate-hold-upload 1000000) (rexel-upload-file (list (rexel-elate-file \"cancel-a.txt\" 500) (rexel-elate-sparse-file \"cancel-b.bin\" (* 90 1024 1024)))))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)"},
    {"assert": {"eval": "(< rexel-elate-stored (length (rexel-elate-uploads)))"}, "comment": "the server holds the files meanwhile"},
    {"keys": "M-x rexel-cancel-upload RET"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: cancelled\")"},
    {"assert": {"eval": "(not (rexel-elate-uploading-p))"}},
    {"eval": "(rexel-elate-release-upload)", "comment": "sends nothing for a cancelled batch"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"u-cancel-9$\")", "comment": "no path after it; not anchored at the line start, as a resize from a long message makes bash redraw the line"},
    {"wait": "until", "pred": "(= rexel-elate-stored (length (rexel-elate-uploads)))", "timeout": 30},

    {"group": "after-cancel", "comment": "a cancelled batch of 16 frees the server's slots at once: 16 more files right after it go through"},
    {"eval": "(setq f-again (mapcar (lambda (i) (rexel-elate-file (format \"again-%02d.txt\" i) 1500)) (number-sequence 1 16)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"type": "cksum "},
    {"wait": "until", "pred": "(rexel-elate-has \"^\\\\$ cksum *$\")"},
    {"eval": "(progn (rexel-elate-hold-upload 100000) (rexel-upload-file (mapcar (lambda (i) (rexel-elate-file (format \"dropped-%02d.txt\" i) 200000)) (number-sequence 1 16))))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)"},
    {"assert": {"eval": "(= 16 (length rexel--uploads))"}},
    {"eval": "(progn (rexel-cancel-upload) (rexel-elate-release-upload) (rexel-upload-file f-again))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"rexel: uploaded 16 files to {{host}}\")", "timeout": 40},
    {"keys": "RET"},
    {"wait": "until", "pred": "(= 16 (rexel-elate-count \"^[0-9]+ 1500 .*again-[0-9][0-9]\\\\.txt$\"))"},
    {"assert": {"eval": "(not (rexel-elate-has \"dropped-\"))"}},

    {"group": "cancel-idle", "comment": "with no upload running the cancel command says so"},
    {"assert": {"eval": "(condition-case nil (progn (rexel-cancel-upload) nil) (user-error t))"}},

    {"group": "two-blocks", "comment": "two blocks upload at the same time, one of them shown in no window; each gets its own files typed"},
    {"eval": "(progn (setq rexel-elate-a (rexel-elate-block)) (rexel-split-right))"},
    {"wait": "until", "pred": "(and (= 2 (length (rexel-elate-blocks))) (seq-every-p #'rexel-elate-live-p (rexel-elate-blocks)))"},
    {"eval": "(progn (setq rexel-elate-b (car (remq rexel-elate-a (rexel-elate-blocks)))) (rexel-elate-send \"exec /bin/bash --norc --noprofile\\n\" rexel-elate-b) (rexel-elate-send \"PS1='$ '\\n\" rexel-elate-b))"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p rexel-elate-b)"},
    {"eval": "(progn (select-window (get-buffer-window rexel-elate-a)) (delete-other-windows))"},
    {"assert": {"eval": "(not (get-buffer-window rexel-elate-b))"}},
    {"eval": "(setq f-a (list (rexel-elate-file \"two-a1.bin\" 3000000) (rexel-elate-file \"two-a2.txt\" 7000)) f-b (list (rexel-elate-file \"two-b1.bin\" 3000000) (rexel-elate-file \"two-b2.txt\" 9000)))"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(progn (rexel-elate-send \"cksum \" rexel-elate-a) (rexel-elate-send \"cksum \" rexel-elate-b))"},
    {"wait": "until", "pred": "(and (rexel-elate-has \"^\\\\$ cksum *$\" rexel-elate-a) (rexel-elate-has \"^\\\\$ cksum *$\" rexel-elate-b))"},
    {"eval": "(progn (rexel-upload-file f-a rexel-elate-a) (rexel-upload-file f-b rexel-elate-b))"},
    {"assert": {"eval": "(and (rexel-elate-uploading-p rexel-elate-a) (rexel-elate-uploading-p rexel-elate-b))"}},
    {"wait": "until", "pred": "(and (not (rexel-elate-uploading-p rexel-elate-a)) (not (rexel-elate-uploading-p rexel-elate-b)))", "timeout": 30},
    {"assert": {"eval": "(and (rexel-elate-messages-p \"rexel: uploaded 2 files to {{host}}\") (not (rexel-elate-messages-p \"upload failed\")))"}},
    {"eval": "(progn (rexel-elate-send \"\\r\" rexel-elate-a) (rexel-elate-send \"\\r\" rexel-elate-b))"},
    {"wait": "until", "pred": "(apply #'rexel-elate-in-order-p (mapcar #'rexel-elate-cksum-line f-a))"},
    {"wait": "until", "pred": "(seq-every-p (lambda (f) (rexel-elate-has (rexel-elate-cksum-line f) rexel-elate-b)) f-b)"},
    {"assert": {"eval": "(not (or (rexel-elate-has \"two-b\" rexel-elate-a) (rexel-elate-has \"two-a\" rexel-elate-b)))"}},

    {"group": "kill-buffer", "comment": "killing the block buffer during an upload ends the batch and the server drops what it had stored"},
    {"eval": "(rexel-elate-clear-messages)"},
    {"eval": "(progn (rexel-elate-hold-upload 100000) (rexel-upload-file (list (rexel-elate-file \"kill-a.txt\" 500) (rexel-elate-file \"kill-b.txt\" 300000))))"},
    {"wait": "until", "pred": "(rexel-elate-upload-held-p)"},
    {"eval": "(setq rexel-elate-kill-files (seq-filter (lambda (f) (string-match-p \"/kill-[ab]\\\\.txt\\\\(?:\\\\.partial\\\\)?\\\\'\" f)) (rexel-elate-uploads)))", "comment": "the file being sent is stored as NAME.partial"},
    {"assert": {"eval": "(= 2 (length rexel-elate-kill-files))"}},
    {"eval": "(kill-buffer (rexel-elate-block))"},
    {"wait": "until", "pred": "(rexel-elate-messages-p \"upload failed: buffer killed\")"},
    {"eval": "(rexel-elate-release-upload)"},
    {"wait": "until", "pred": "(not (seq-some #'file-exists-p rexel-elate-kill-files))", "timeout": 30},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
