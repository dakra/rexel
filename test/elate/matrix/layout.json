{
  "name": "layout",
  "comment": "Sizes and the layout commands behind C-c C-r: the terminal follows its window, also under a full-screen program, and another client that takes the block, splits and tabs make blocks on the server and windows here, rexel-sync-layout rebuilds the windows, and closed blocks lose their buffers.  `stty size' in the block is the oracle for sizes.",
  "params": {"host": "local"},
  "variants": {
    "local": {"host": "local"},
    "unix": {"host": "unix"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(rexel-elate-start \"{{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"eval": "(setq rexel-elate-first (rexel-elate-block))"},

    {"group": "size", "comment": "the program sees the size of the window showing it"},
    {"wait": "until", "pred": "(rexel-elate-fits-p)"},
    {"type": "echo z1 $(stty size)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-size-line \"z1\"))"},

    {"group": "resize", "comment": "resizing the frame resizes the terminal"},
    {"resize": "90x28"},
    {"wait": "until", "pred": "(and (= (frame-width) 90) (rexel-elate-fits-p))"},
    {"assert": {"eval": "(< (car (rexel-elate-size)) 95)"}},
    {"type": "echo z2 $(stty size)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-size-line \"z2\"))"},
    {"resize": "120x36"},
    {"wait": "until", "pred": "(and (= (frame-width) 120) (rexel-elate-fits-p))"},

    {"group": "resize-full-screen", "comment": "a full-screen program redraws for the new size when the frame resizes under it"},
    {"type": "seq 1 500 | less"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^1$\")"},
    {"resize": "90x28"},
    {"wait": "until", "pred": "(and (= (frame-width) 90) (rexel-elate-fits-p))"},
    {"type": "G"},
    {"wait": "until", "pred": "(equal (split-string (string-trim-right (rexel-elate-text)) \"\\n\") (append (mapcar #'number-to-string (number-sequence (- 502 (cdr (rexel-elate-size))) 500)) '(\"(END)\")))", "comment": "less fills exactly the new rows"},
    {"resize": "120x36"},
    {"wait": "until", "pred": "(and (= (frame-width) 120) (rexel-elate-fits-p))"},
    {"type": "G"},
    {"wait": "until", "pred": "(equal (split-string (string-trim-right (rexel-elate-text)) \"\\n\") (append (mapcar #'number-to-string (number-sequence (- 502 (cdr (rexel-elate-size))) 500)) '(\"(END)\")))"},
    {"type": "q"},
    {"wait": "until", "pred": "(and (rexel-elate-prompt-p) (not (rexel-elate-has \"(END)\")))"},

    {"group": "taken-back", "comment": "another client that takes the block sizes it until a window starts showing it here again"},
    {"eval": "(rexel-elate-other-take 50 20)"},
    {"wait": "until", "pred": "(equal (rexel-elate-size) '(50 . 20))"},
    {"resize": "110x34"},
    {"wait": "until", "pred": "(and (= (frame-width) 110) (equal (rexel-elate-window-size) (with-current-buffer (rexel-elate-block) rexel--requested-size)))", "comment": "Emacs asked for the new window size"},
    {"wait": "idle", "min_idle": 1},
    {"assert": {"eval": "(equal (rexel-elate-size) '(50 . 20))"}, "comment": "the other client still owns the size"},
    {"type": "echo z10 $(stty size)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^z10 20 50$\")"},
    {"eval": "(let ((b (window-buffer))) (switch-to-buffer \"*scratch*\") (redisplay) (switch-to-buffer b))"},
    {"wait": "until", "pred": "(rexel-elate-fits-p)"},
    {"type": "echo z11 $(stty size)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-size-line \"z11\"))"},
    {"eval": "(rexel-elate-other-leave)"},
    {"resize": "120x36"},
    {"wait": "until", "pred": "(and (= (frame-width) 120) (rexel-elate-fits-p))"},

    {"group": "smallest-window", "comment": "a block shown in two windows takes the size of the smaller"},
    {"eval": "(split-window-right 40)"},
    {"wait": "until", "pred": "(and (= 2 (length (get-buffer-window-list (rexel-elate-block)))) (rexel-elate-fits-p))"},
    {"assert": {"eval": "(< (car (rexel-elate-size)) 45)"}},
    {"type": "echo z9 $(stty size)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-size-line \"z9\"))"},
    {"eval": "(delete-other-windows)"},
    {"wait": "until", "pred": "(rexel-elate-fits-p)"},

    {"group": "split-right", "comment": "C-c C-r 3 makes a shell to the right, selected and sized to its window"},
    {"type": "cd /usr/share && echo c0-ok"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^c0-ok$\")"},
    {"eval": "(setq default-directory \"/usr/lib/\")", "comment": "a default-directory the shell is not in, which the split-directory group expects the split to ignore"},
    {"keys": "C-c C-r 3"},
    {"wait": "until", "pred": "(and (= 2 (length (rexel-elate-blocks))) (not (eq (window-buffer) rexel-elate-first)) (rexel-elate-live-p))"},
    {"assert": {"eval": "(and (= 2 (length (window-list))) (eq (window-buffer (window-in-direction 'left)) rexel-elate-first))"}},
    {"assert": {"eval": "(equal (rexel-elate-tabs) '(2))"}},
    {"wait": "until", "pred": "(rexel-elate-fits-p)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"type": "echo z3 $(stty size)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has (rexel-elate-size-line \"z3\"))"},
    {"assert": {"eval": "(< (car (rexel-elate-size)) 62)"}},
    {"wait": "until", "pred": "(rexel-elate-fits-p rexel-elate-first)", "comment": "the first block shrank with its window"},

    {"group": "split-directory", "comment": "a split's shell starts in the directory of the current block's shell, also after a cd that reports nothing"},
    {"type": "echo d1:$PWD"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^d1:/\")"},
    {"assert": {"eval": "(rexel-elate-has \"^d1:/usr/share$\")"}},

    {"group": "split-below", "comment": "C-c C-r 2 makes a shell below the current block"},
    {"eval": "(setq rexel-elate-anchor (window-buffer))"},
    {"keys": "C-c C-r 2"},
    {"wait": "until", "pred": "(and (= 3 (length (rexel-elate-blocks))) (not (eq (window-buffer) rexel-elate-anchor)) (rexel-elate-live-p))"},
    {"assert": {"eval": "(and (= 3 (length (window-list))) (eq (window-buffer (window-in-direction 'above)) rexel-elate-anchor))"}},
    {"assert": {"eval": "(equal (rexel-elate-tabs) '(3))"}},

    {"group": "split-left", "comment": "C-c C-r <left> makes a shell to the left"},
    {"eval": "(progn (select-window (get-buffer-window rexel-elate-first)) (delete-other-windows))"},
    {"keys": "C-c C-r <left>"},
    {"wait": "until", "pred": "(and (= 4 (length (rexel-elate-blocks))) (not (eq (window-buffer) rexel-elate-first)) (rexel-elate-live-p))"},
    {"assert": {"eval": "(eq (window-buffer (window-in-direction 'right)) rexel-elate-first)"}},

    {"group": "split-above", "comment": "C-c C-r <up> makes a shell above"},
    {"eval": "(progn (select-window (get-buffer-window rexel-elate-first)) (delete-other-windows))"},
    {"keys": "C-c C-r <up>"},
    {"wait": "until", "pred": "(and (= 5 (length (rexel-elate-blocks))) (not (eq (window-buffer) rexel-elate-first)) (rexel-elate-live-p))"},
    {"assert": {"eval": "(eq (window-buffer (window-in-direction 'below)) rexel-elate-first)"}},

    {"group": "split", "comment": "C-c C-r RET splits where the window has room"},
    {"eval": "(progn (select-window (get-buffer-window rexel-elate-first)) (delete-other-windows))"},
    {"keys": "C-c C-r RET"},
    {"wait": "until", "pred": "(and (= 6 (length (rexel-elate-blocks))) (not (eq (window-buffer) rexel-elate-first)) (rexel-elate-live-p))"},
    {"assert": {"eval": "(and (= 2 (length (window-list))) (equal (rexel-elate-tabs) '(6)))"}},

    {"group": "sync-layout", "comment": "C-c C-r = rebuilds the frame's windows from the tab: one window per block"},
    {"eval": "(progn (select-window (get-buffer-window rexel-elate-first)) (delete-other-windows))"},
    {"keys": "C-c C-r ="},
    {"wait": "until", "pred": "(= 6 (length (window-list)))"},
    {"assert": {"eval": "(= 6 (length (delete-dups (mapcar #'window-buffer (window-list)))))"}},
    {"assert": {"eval": "(seq-every-p (lambda (w) (buffer-local-value 'rexel--block-id (window-buffer w))) (window-list))"}},
    {"wait": "until", "pred": "(seq-every-p (lambda (w) (rexel-elate-fits-p (window-buffer w))) (window-list))", "comment": "every block is sized to its window"},

    {"group": "new-tab", "comment": "C-c C-r c asks for a label and opens a tab with one shell"},
    {"eval": "(progn (select-window (get-buffer-window rexel-elate-first)) (delete-other-windows))"},
    {"keys": "C-c C-r c", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Tab label: "}}},
    {"type": "logs"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (= 7 (length (rexel-elate-blocks))) (not (eq (window-buffer) rexel-elate-first)) (rexel-elate-live-p))"},
    {"assert": {"eval": "(equal (rexel-elate-tabs) '(6 1))"}},
    {"eval": "(setq rexel-elate-tab (window-buffer))"},

    {"group": "sync-tab", "comment": "C-u C-c C-r = asks for a tab; outside a block buffer the command uses the active tab"},
    {"keys": "C-u C-c C-r =", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Rex tab: "}}},
    {"eval": "(rexel-elate-answer (car (seq-filter (lambda (c) (string-prefix-p \"1: \" c)) (with-selected-window (active-minibuffer-window) (all-completions \"\" minibuffer-completion-table)))))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(= 6 (length (window-list)))"},
    {"assert": {"eval": "(not (memq rexel-elate-tab (mapcar #'window-buffer (window-list))))"}},
    {"eval": "(progn (delete-other-windows) (switch-to-buffer \"*scratch*\"))"},
    {"keys": "M-x rexel-sync-layout RET"},
    {"wait": "until", "pred": "(seq-some (lambda (w) (buffer-local-value 'rexel--block-id (window-buffer w))) (window-list))"},

    {"group": "close-block", "comment": "C-c C-r x asks, then ends the block and kills its buffer"},
    {"eval": "(progn (pop-to-buffer-same-window rexel-elate-tab) (delete-other-windows))"},
    {"keys": "C-c C-r x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "n"},
    {"wait": "idle", "min_idle": 0.5},
    {"assert": {"eval": "(buffer-live-p rexel-elate-tab)"}, "comment": "answering no keeps it"},
    {"eval": "(pop-to-buffer-same-window rexel-elate-tab)"},
    {"keys": "C-c C-r x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "y"},
    {"wait": "until", "pred": "(not (buffer-live-p rexel-elate-tab))"},
    {"wait": "until", "pred": "(equal (rexel-elate-tabs) '(6))"},
    {"assert": {"eval": "(= 6 (length (rexel-elate-blocks)))"}},

    {"group": "exit", "comment": "a shell that exits closes its block and buffer"},
    {"eval": "(progn (pop-to-buffer-same-window (seq-find (lambda (b) (not (eq b rexel-elate-first))) (rexel-elate-blocks))) (delete-other-windows) (setq rexel-elate-leaving (window-buffer)))"},
    {"type": "exit"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(not (buffer-live-p rexel-elate-leaving))"},
    {"wait": "until", "pred": "(equal (rexel-elate-tabs) '(5))"},
    {"assert": {"eval": "(and (buffer-live-p rexel-elate-first) (rexel-elate-live-p rexel-elate-first))"}},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
