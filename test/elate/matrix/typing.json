{
  "name": "typing",
  "comment": "Keys typed into a block reach its program in order, over every kind of server address, and the program's output comes back: line editing, paste (large, bracketed and over a slow link), interrupt, function and cursor keys, a full-screen program, scrollback, copy mode and a large burst of output.",
  "params": {"host": "local"},
  "variants": {
    "local": {"host": "local"},
    "unix": {"host": "unix"},
    "tcp": {"host": "tcp"},
    "fallback": {"host": "fallback"},
    "tls": {"host": "tls"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/rexel-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(rexel-elate-start \"{{host}}\")"},
    {"wait": "until", "pred": "(rexel-elate-live-p)"},
    {"eval": "(delete-other-windows)"},
    {"eval": "(rexel-elate-shell)"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},

    {"group": "echo", "comment": "a typed command runs and its output shows"},
    {"type": "echo t1-$((6*7))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t1-42$\")"},
    {"wait": "until", "pred": "(rexel-elate-shows \"^t1-42$\")", "comment": "rendered in the Emacs buffer too"},

    {"group": "burst", "comment": "a fast run of keys arrives complete and in order"},
    {"type": "echo t2-0123456789abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 | tr a-z A-Z"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^T2-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$\")"},

    {"group": "edit", "comment": "backspace, C-a and history recall act on the shell's line"},
    {"type": "echo t3-okXY"},
    {"keys": "DEL DEL RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t3-ok$\")"},
    {"type": "t4-$((9*9))"},
    {"keys": "C-a"},
    {"type": "echo "},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t4-81$\")"},
    {"keys": "<up> RET"},
    {"wait": "until", "pred": "(= 2 (rexel-elate-count \"^t4-81$\"))"},

    {"group": "paste", "comment": "C-y pastes the kill ring into the terminal"},
    {"eval": "(kill-new \"t5-$((3*4))\")"},
    {"type": "echo "},
    {"keys": "C-y RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t5-12$\")"},

    {"group": "unicode", "comment": "non-ASCII input and output survive both ways"},
    {"eval": "(kill-new \"t6-äöü-λ-日本語\")"},
    {"type": "echo "},
    {"keys": "C-y RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t6-äöü-λ-日本語$\")"},
    {"type": "echo t6b-ßé-日本"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t6b-ßé-日本$\")", "comment": "typed, not pasted"},
    {"assert": {"eval": "(with-current-buffer (rexel-elate-block) (not buffer-read-only))"}, "comment": "an Emacs input method composes only in a buffer that takes edits"},

    {"group": "interrupt", "comment": "C-c C-c interrupts the running program"},
    {"type": "sleep 307"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(= 0 (call-process \"pgrep\" nil nil nil \"-fx\" \"sleep 307\"))", "comment": "the program runs"},
    {"keys": "C-c C-c"},
    {"wait": "until", "pred": "(/= 0 (call-process \"pgrep\" nil nil nil \"-fx\" \"sleep 307\"))", "timeout": 8, "comment": "and is gone"},
    {"type": "echo t7-$((5*5))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t7-25$\")", "timeout": 8},

    {"group": "full-screen", "comment": "a full-screen program takes keys, cursor keys included, and gives the screen back"},
    {"type": "seq 1 500 | less"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^1$\")"},
    {"keys": "<down> <down> <down>"},
    {"wait": "until", "pred": "(string-prefix-p \"4\\n5\\n\" (rexel-elate-text))", "comment": "the screen starts at line 4"},
    {"keys": "<next>"},
    {"wait": "until", "pred": "(string-prefix-p (format \"%d\\n\" (+ 3 (cdr (rexel-elate-size)))) (rexel-elate-text))", "comment": "a page is the rows less the status line"},
    {"type": "G"},
    {"wait": "until", "pred": "(rexel-elate-has \"(END)\")"},
    {"assert": {"eval": "(rexel-elate-has \"^500$\")"}},
    {"type": "q"},
    {"wait": "until", "pred": "(and (rexel-elate-prompt-p) (not (rexel-elate-has \"(END)\")))"},

    {"group": "keys", "comment": "function and cursor keys reach the program as xterm sequences"},
    {"type": "stty -echo; echo k0-$((3*3)); cat -v; stty echo"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^k0-9$\")", "comment": "the tty no longer echoes"},
    {"keys": "<f5> <up> <f12> <home> RET"},
    {"wait": "until", "pred": "(rexel-elate-has (concat \"^\" (regexp-quote \"^[[15~^[[A^[[24~^[[H\") \"$\"))"},
    {"keys": "C-d"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},

    {"group": "scrollback", "comment": "output that scrolled off stays in the buffer"},
    {"type": "seq 1001 1300"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^1300$\")"},
    {"wait": "until", "pred": "(and (rexel-elate-shows \"^1001$\") (rexel-elate-shows \"^1300$\"))"},

    {"group": "copy-mode", "comment": "C-c C-t freezes the view for isearch and copying; leaving shows what arrived meanwhile and types nothing"},
    {"keys": "C-c C-t C-r 1 1 5 0 RET C-a C-SPC C-e M-w q"},
    {"assert": {"eval": "(equal (current-kill 0) \"1150\")"}},
    {"assert": {"eval": "(eq ghostel--input-mode 'semi-char)"}},
    {"type": "sleep 1; echo c2-$((4*4))"},
    {"keys": "RET C-c C-t"},
    {"wait": "until", "pred": "(rexel-elate-has \"^c2-16$\")"},
    {"wait": "idle", "min_idle": 0.5, "comment": "time for a redraw a live buffer would get"},
    {"assert": {"eval": "(and (eq ghostel--input-mode 'copy) (not (rexel-elate-shows \"^c2-16$\")))"}, "comment": "the terminal has it, the frozen buffer not yet"},
    {"keys": "q"},
    {"wait": "until", "pred": "(rexel-elate-shows \"^c2-16$\")"},
    {"type": "echo c3-$((8*8))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^c3-64$\")"},
    {"assert": {"eval": "(rexel-elate-has \"^\\\\$ echo c3-\")"}, "comment": "no q reached the shell"},

    {"group": "flood", "comment": "a large burst of output arrives whole and the stream stays live"},
    {"type": "seq 1 60000; echo t8-$((7*6))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t8-42$\")", "timeout": 60},
    {"assert": {"eval": "(rexel-elate-live-p)"}},
    {"assert": {"eval": "(rexel-elate-has (concat \"^\" (regexp-quote (mapconcat #'number-to-string (number-sequence 57001 60000) \"\\n\")) \"\\nt8-42$\"))"}, "comment": "the last 3000 lines, each once and in order"},
    {"type": "echo t9-$((2*2))"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^t9-4$\")"},

    {"group": "large-paste", "comment": "a 48 KB paste reaches the program intact and in order"},
    {"eval": "(setq rexel-elate-paste (mapconcat (lambda (i) (format \"p%05d %s\\n\" i (secure-hash 'sha1 (number-to-string i)))) (number-sequence 1 1000) \"\"))"},
    {"eval": "(let ((file (expand-file-name \"paste.txt\" rexel-elate-files-dir))) (make-directory rexel-elate-files-dir t) (with-temp-file file (insert rexel-elate-paste)) (setq rexel-elate-paste-line (format \"^%s$\" (rexel-elate-cksum file))))"},
    {"type": "stty -echo; echo p0-$((3*3)); cat | cksum; stty echo"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-has \"^p0-9$\")", "comment": "the tty no longer echoes"},
    {"eval": "(kill-new rexel-elate-paste)"},
    {"keys": "C-y C-d"},
    {"wait": "until", "pred": "(rexel-elate-has rexel-elate-paste-line)", "timeout": 30},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},

    {"group": "bracketed-paste", "comment": "a shell with bracketed paste gets a multi-line paste as one edit and runs it on RET; needs bash 5.1 or later"},
    {"eval": "(rexel-elate-send (format \"exec %s --norc --noprofile\\n\" (seq-find #'file-executable-p '(\"/opt/homebrew/bin/bash\" \"/usr/local/bin/bash\" \"/usr/bin/bash\" \"/bin/bash\"))))"},
    {"eval": "(rexel-elate-send \"PS1='$ '; echo bp-$(( BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 501 ))\\n\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^bp-1$\")", "comment": "the shell is bash 5.1 or later"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"eval": "(kill-new \"echo b1-$((1+1))\\necho b2-$((2+2))\")"},
    {"keys": "C-y"},
    {"wait": "until", "pred": "(rexel-elate-has \"^echo b2-\\\\$((2\\\\+2))$\")", "comment": "the second line is part of the edit"},
    {"assert": {"eval": "(not (rexel-elate-has \"^b1-2$\"))"}, "comment": "nothing ran before RET"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p \"^b1-2$\" \"^b2-4$\")"},

    {"group": "zsh-paste", "comment": "over a slow link zsh gets a multi-line paste as one edit and runs it on RET; zsh ends a paste whose text comes more than KEYTIMEOUT after the start bracket, and each newline after that runs a line"},
    {"eval": "(when-let* ((zsh (executable-find \"zsh\"))) (rexel-elate-send (format \"exec %s -f\\n\" zsh)))", "comment": "without zsh the bash of the last group takes the paste, which checks only that it arrives whole: bash does not time out"},
    {"eval": "(rexel-elate-send \"PS1='$ '; echo zp-$((6*6))\\n\")"},
    {"wait": "until", "pred": "(rexel-elate-has \"^zp-36$\")", "comment": "the new shell runs"},
    {"wait": "until", "pred": "(rexel-elate-prompt-p)"},
    {"eval": "(rexel-elate-delay-request \"com.superlogical.terminal.write\" 0.6)"},
    {"eval": "(kill-new \"echo z1-$((1+1))\\necho z2-$((2+2))\\necho z3-$((3+3))\")"},
    {"keys": "C-y"},
    {"wait": "until", "pred": "(rexel-elate-has \"^echo z3-\\\\$((3\\\\+3))$\")", "comment": "the last line is part of the edit"},
    {"wait": "idle", "min_idle": 1},
    {"assert": {"eval": "(not (rexel-elate-has \"^z1-2$\"))"}, "comment": "nothing ran before RET"},
    {"eval": "(rexel-elate-undelay-requests)"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(rexel-elate-in-order-p \"^z1-2$\" \"^z2-4$\" \"^z3-6$\")"},

    {"group": "cleanup"},
    {"eval": "(rexel-elate-cleanup)"}
  ]
}
